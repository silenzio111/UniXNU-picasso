+	bool        panic_test;
+	bool        panic_mode;
+	bool        panic_pending;
+	bool        panic_reset;
+	bool        cmd_pending;
+	bool        reboot_pending;
+	bool        reset_pending;
+	bool        hang_pending;
+	bool        watchdog;
