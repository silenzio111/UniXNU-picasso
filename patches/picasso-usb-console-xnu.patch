+/* Picasso USB debug console: CDC-ACM log streaming over DWC3.
+ *
+ * Port of the vermeer (ios-vermeer-lab) USB bring-up to the UniXNU Darwin 23
+ * kernel. The console mirror ring is streamed on the bulk IN endpoint, panic
+ * output uses a separate synchronous path, and the bulk OUT endpoint accepts a
+ * small diagnostic command set.
+ *
+ * Hardware notes (SM7250): the USB controller is a Synopsys DWC3 at
+ * 0x0a600000 behind Qualcomm's dwc-usb3-msm wrapper (QSCRATCH at +0xf8800),
+ * the same IP generation as SM8550/SM8650 whose constants vermeer validated.
+ * The controller is only touched when GCC reports the USB30_PRIM power
+ * domain on; the soft reset is bounded. The wrapper is told to use UTMI as
+ * the PIPE clock because Picasso has no enabled SuperSpeed PHY, but no clock
+ * rate or PHY power state is changed here. ABL/UEFI leave the controller
+ * powered from the fastboot session. Boot-arg picasso_usb=1 probes state
+ * only, 2 also runs the console.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <machine/atomic.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern uint64_t kvtophys(vm_offset_t va);
+extern void console_write_unbuffered(char);
+
+/* ------------------------------------------------------------------ */
+/* Console mirror ring: any context, best effort, never waits.        */
+
+#define PURing_SIZE   (256 * 1024)
+#define PURing_MASK   (PURing_SIZE - 1)
+#define PU_PANIC_RING_SIZE  (128u * 1024u)
+#define PU_PANIC_RING_MASK  (PU_PANIC_RING_SIZE - 1)
+#define PU_CMD_SIZE         80u
+#define PSHOLD_PA           0x0c264000u
+#define APSS_WDT_PA         0x17c10000u
+#define IMEM_PA             0x146ab000u
+#define IMEM_RESTART_REASON 0x65cu
+#define IMEM_FASTBOOT_MODE  0x77665500u
+#define APSS_WDT_RST        0x04u
+#define APSS_WDT_EN         0x08u
+#define APSS_WDT_BARK       0x10u
+#define APSS_WDT_BITE       0x14u
+#define APSS_WDT_RATE_HZ    32768u
+#define APSS_WDT_TIMEOUT_MS 15000u
+/* Picasso readback truncates at 20 bits, matching vendor WDOG_BITE_TIME. */
+#define APSS_WDT_COUNTER_MAX 0xfffffu
+#define APSS_WDT_MAX_TIMEOUT_MS 32000u
+#define APSS_WDT_FORCED_BITE 4u
+#define PICASSO_USB_CONTROL_DEFAULT_MS 60000u
+#define PICASSO_USB_CONTROL_RESET_DEFAULT_MS 15000u
+#define PICASSO_USB_HOST_TIMEOUT_MS 60000u
+#define PICASSO_USB_HOST_BOOT_GRACE_MS 120000u
+#define PICASSO_USB_FLUSH_POLLS 64u
+#define PICASSO_USB_FINAL_FLUSH_POLLS 8u
+#define PICASSO_USB_FLUSH_GAP_US 100u
+
+enum picasso_usb_reset_mode {
+	PICASSO_USB_RESET_WATCHDOG = 0,
+	PICASSO_USB_RESET_PSCI = 1,
+	PICASSO_USB_RESET_PSHOLD = 2
+};
+
+static struct {
+	char        buffer[PURing_SIZE];
+	uint64_t    total;
+} pur_ring;
+static struct {
+	char        buffer[PU_PANIC_RING_SIZE];
+	uint64_t    total;
+} pup_ring;
+static uint32_t _Atomic pur_lock;
+static uint64_t _Atomic pur_dropped;
+static uint64_t pup_pos;
+static uint32_t _Atomic pup_flush_lock;
+static bool pur_live;                   /* set once the TX thread streams */
+static bool pu_panic_active;
+
+struct pur_text {
+	char     bytes[96];
+	uint32_t length;
+};
+
+void picasso_usb_log_char(char c);
+void picasso_usb_log_write(const char *data, uint32_t length);
+void picasso_usb_console_start(void);
+void picasso_usb_panic_begin(void);
+void picasso_usb_panic_putc(char c);
+void picasso_usb_panic_write(const char *text, int size);
+void picasso_usb_panic_flush(void);
+void picasso_usb_panic_reset(void);
+static void picasso_usb_console_drive_poll(void);
+static void ud_process_command(void);
+static void ud_finish_reboot(void);
+static void picasso_usb_watchdog_disable(void);
+static bool picasso_usb_arm_fastboot_reason(void);
+static void picasso_usb_watchdog_reset(void);
+static void ud_configure(void);
+
+void
+picasso_usb_log_write(const char *data, uint32_t length)
+{
+	if (pu_panic_active || data == NULL || length == 0) {
+		return;
+	}
+	if (!os_atomic_cmpxchg(&pur_lock, 0, 1, acquire)) {
+		os_atomic_add(&pur_dropped, length, relaxed);
+		return;
+	}
+	for (uint32_t i = 0; i < length; i++) {
+		pur_ring.buffer[pur_ring.total & PURing_MASK] = data[i];
+		pur_ring.total++;
+	}
+	os_atomic_store(&pur_lock, 0, release);
+	/*
+	 * bsd_init still runs before early kernel threads reliably receive CPU.
+	 * Drive the DWC3 event ring from console output itself until the
+	 * background poller becomes schedulable.
+	 */
+	picasso_usb_console_drive_poll();
+}
+
+void
+picasso_usb_log_char(char c)
+{
+	picasso_usb_log_write(&c, 1);
+}
+
+/*
+ * Event logging may run from inside console output, so it must never call
+ * printf() recursively. Append the complete diagnostic line to the console
+ * ring with one lock acquisition instead.
+ */
+static void
+pur_emit_raw(const char *data, uint32_t length)
+{
+	if (!os_atomic_cmpxchg(&pur_lock, 0, 1, acquire)) {
+		os_atomic_add(&pur_dropped, length, relaxed);
+		return;
+	}
+	for (uint32_t i = 0; i < length; i++) {
+		pur_ring.buffer[pur_ring.total & PURing_MASK] = data[i];
+		pur_ring.total++;
+	}
+	os_atomic_store(&pur_lock, 0, release);
+}
+
+static void
+pur_text_append(struct pur_text *text, const char *value)
+{
+	while (*value != '\0' && text->length < sizeof(text->bytes)) {
+		text->bytes[text->length++] = *value++;
+	}
+}
+
+static void
+pur_text_u64(struct pur_text *text, uint64_t value)
+{
+	char digits[20];
+	uint32_t count = 0;
+	do {
+		digits[count++] = (char)('0' + value % 10);
+		value /= 10;
+	} while (value != 0);
+	while (count != 0 && text->length < sizeof(text->bytes)) {
+		text->bytes[text->length++] = digits[--count];
+	}
+}
+
+static void
+pur_text_hex32(struct pur_text *text, uint32_t value)
+{
+	static const char hex[] = "0123456789abcdef";
+	for (int shift = 28; shift >= 0; shift -= 4) {
+		if (text->length < sizeof(text->bytes)) {
+			text->bytes[text->length++] = hex[(value >> shift) & 0xfu];
+		}
+	}
+}
+
+static void
+pur_emit_event(uint64_t index, unsigned ep, uint32_t event)
+{
+	struct pur_text text = { .length = 0 };
+	pur_text_append(&text, "PICASSO USB: event ");
+	pur_text_u64(&text, index);
+	pur_text_append(&text, " ep");
+	pur_text_u64(&text, ep);
+	pur_text_append(&text, " 0x");
+	pur_text_hex32(&text, event);
+	pur_text_append(&text, "\r\n");
+	pur_emit_raw(text.bytes, text.length);
+}
+
+static uint32_t
+pur_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	uint32_t n = 0;
+	if (!os_atomic_cmpxchg(&pur_lock, 0, 1, acquire)) {
+		return 0;
+	}
+	if (pur_ring.total - *pos > PURing_SIZE) {
+		*pos = pur_ring.total - PURing_SIZE;
+	}
+	n = (uint32_t)MIN((uint64_t)max, pur_ring.total - *pos);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = pur_ring.buffer[(*pos + i) & PURing_MASK];
+	}
+	*pos += n;
+	os_atomic_store(&pur_lock, 0, release);
+	return n;
+}
+
+static uint32_t
+pup_copy(char *out, uint32_t max)
+{
+	uint64_t pending = pup_ring.total - pup_pos;
+	uint32_t n = (uint32_t)MIN((uint64_t)max, pending);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = pup_ring.buffer[(pup_pos + i) & PU_PANIC_RING_MASK];
+	}
+	pup_pos += n;
+	return n;
+}
+
+/* ------------------------------------------------------------------ */
+/* DWC3 device mode, EP0 + one bulk IN pair. Register layout follows   */
+/* the Synopsys databook as used by Linux drivers/usb/dwc3.           */
+
+#define GCC_PA                  0x00100000u
+#define GCC_SIZE                0x00090000u
+#define GCC_USB30_PRIM_GDSCR    0x0f004u         /* bit 31: power on */
+#define GCC_USB30_PRIM_MASTER   0x0f010u
+#define GCC_USB30_PRIM_SLEEP    0x0f018u
+#define GCC_USB30_PRIM_MOCK_UTMI 0x0f01cu
+#define GCC_CFG_NOC_USB3_PRIM   0x0f07cu
+#define GCC_AGGRE_USB3_PRIM     0x0f080u
+#define GCC_USB3_PRIM_CLKREF    0x8c010u
+
+#define SMMU_PA                 0x15000000u
+#define SMMU_SIZE               0x000d0000u
+#define USB_STREAM_ID           0x00e0u
+
+#define DWC3_PA                 0x0a600000u
+#define DWC3_SIZE               0x00100000u
+#define QSCRATCH_OFFSET         0x000f8800u
+#define QSCRATCH_PA             (DWC3_PA + QSCRATCH_OFFSET)
+#define QSCRATCH_GENERAL_CFG    0x08u
+#define   PIPE_UTMI_CLK_SEL     (1u << 0)
+#define   PIPE3_PHYSTATUS_SW    (1u << 3)
+#define   PIPE_UTMI_CLK_DIS     (1u << 8)
+#define QSCRATCH_HS_PHY_CTRL    0x10u
+#define   UTMI_OTG_VBUS_VALID   (1u << 20)
+#define   SW_SESSVLD_SEL        (1u << 28)
+#define QSCRATCH_CGCTL          0x28u
+#define QSCRATCH_SS_PHY_CTRL    0x30u
+#define   LANE0_PWR_PRESENT     (1u << 24)
+#define QSCRATCH_PWR_EVT_STAT   0x58u
+#define QSCRATCH_PWR_EVT_MASK   0x5cu
+
+#define GCTL            0xc110u
+#define GHWPARAMS3      0xc14cu
+#define GHWPARAMS4      0xc150u
+#define GHWPARAMS5      0xc154u
+#define GHWPARAMS6      0xc158u
+#define GHWPARAMS7      0xc15cu
+#define GUSB2PHYCFG0    0xc200u
+#define GUSB3PIPECTL0   0xc2c0u
+#define GTXFIFOSIZ(n)   (0xc300u + 4u * (n))
+#define GRXFIFOSIZ(n)   (0xc380u + 4u * (n))
+#define GEVNTADRLO      0xc400u
+#define GEVNTADRHI      0xc404u
+#define GEVNTSIZ        0xc408u
+#define GEVNTCOUNT      0xc40cu
+#define DCFG            0xc700u
+#define DCTL            0xc704u
+#define DEVTEN          0xc708u
+#define DSTS            0xc70cu
+#define DALEPENA        0xc720u
+#define DEPCMDPAR2(n)   (0xc800u + 0x10u * (n))
+#define DEPCMDPAR1(n)   (0xc804u + 0x10u * (n))
+#define DEPCMDPAR0(n)   (0xc808u + 0x10u * (n))
+#define DEPCMD(n)       (0xc80cu + 0x10u * (n))
+
+#define DCTL_RUN_STOP   (1u << 31)
+#define DCTL_CSFTRST    (1u << 30)
+#define DSTS_DEVCTRLHLT (1u << 22)
+#define GUSB2PHYCFG_SUSPHY   (1u << 6)
+#define GUSB2PHYCFG_ENBLSLPM (1u << 8)
+#define GUSB3PIPECTL_SUSPHY  (1u << 17)
+
+#define DEPCMD_SETEPCONFIG      1u
+#define DEPCMD_SETTRANSFRESOURCE 2u
+#define DEPCMD_GETEPSTATE       3u
+#define DEPCMD_SETSTALL         4u
+#define DEPCMD_CLEARSTALL       5u
+#define DEPCMD_STARTTRANSFER    6u
+#define DEPCMD_UPDATETRANSFER   7u
+#define DEPCMD_ENDTRANSFER      8u
+#define DEPCMD_DEPSTARTCFG      9u
+#define DEPCMD_FORCE_RM         (1u << 11)
+#define DEPCMD_CMDACT           (1u << 10)
+#define DEPCMD_CMDIOC           (1u << 8)
+
+#define UD_EPCMD_NO_RESOURCE    (-2)
+
+#define TRB_HWO         (1u << 0)
+#define TRB_LST         (1u << 1)
+#define TRB_CSP         (1u << 3)
+#define TRB_ISP_IMI     (1u << 10)
+#define TRB_IOC         (1u << 11)
+#define TRBCTL_NORMAL   (1u << 4)
+#define TRBCTL_SETUP    (2u << 4)
+#define TRBCTL_STATUS2  (3u << 4)
+#define TRBCTL_STATUS3  (4u << 4)
+#define TRBCTL_DATA     (5u << 4)
+#define TRBCTL_LINK     (8u << 4)
+
+/* physical endpoints: 0/1 = ep0 OUT/IN, 2 = bulk OUT, 3 = bulk IN */
+#define EP_RX           2u
+#define EP_TX           3u
+#define EP_NOTIFY       5u
+
+#define UD_DIAG_REQUEST 0x50u
+#define UD_DIAG_MAGIC   0x50554447u
+
+/* DMA area layout */
+#define UD_EVT          0x0000u         /* event buffer, 4 KiB */
+#define UD_EVT_SIZE     0x1000u
+#define UD_TRB_OUT      0x1000u         /* ep0 OUT TRB */
+#define UD_TRB_IN       0x1010u         /* ep0 IN TRB */
+#define UD_TRB_TX       0x1030u         /* bulk IN TRB */
+#define UD_TRB_RX       0x1080u         /* bulk OUT TRB */
+#define UD_TRB_RX_LINK  0x1090u         /* bulk OUT ring link */
+#define UD_TRB_NOTIFY   0x1020u         /* interrupt IN endpoint */
+#define UD_SETUP        0x1040u         /* 8-byte setup packet */
+#define UD_DATA         0x1100u         /* ep0 data stage, 512 bytes */
+#define UD_NOTIFY       0x1800u         /* CDC serial-state notification */
+#define UD_NOTIFY_SIZE  10u
+#define UD_TX           0x2000u         /* bulk IN log chunk, 4 KiB */
+#define UD_TX_SIZE      0x1000u
+#define UD_RX           0x3000u         /* bulk OUT command chunk */
+#define UD_RX_SIZE      0x200u
+#define UD_SIZE         0x4000u
+
+static struct {
+	vm_offset_t dwc;
+	vm_offset_t dma;
+	uint64_t    dma_pa;
+	uint32_t    evt_pos;
+	int         sleep_chan;
+	enum { EP0_SETUP, EP0_DATA, EP0_WAIT_STATUS2, EP0_WAIT_STATUS3, EP0_STATUS } state;
+	bool        data_in;
+	uint8_t     last_request;
+	uint16_t    data_length;
+	bool        configured;
+	bool        ep0_busy;
+	bool        ep0_ready;
+	bool        tx_busy;
+	bool        rx_busy;
+	bool        rx_transfer_started;
+	bool        notify_busy;
+	bool        trace_commands;
+	bool        smmu_guard;
+	bool        live;
+	bool        hold;
+	unsigned    control_ms;
+	bool        control_reset;
+	unsigned    control_reset_ms;
+	uint64_t    control_deadline;
+	bool        host_open;
+	bool        host_seen;
+	uint64_t    host_deadline;
+	unsigned    host_timeout_ms;
+	unsigned    host_boot_grace_ms;
+	bool        panic_test;
+	bool        panic_mode;
+	bool        panic_pending;
+	bool        start_kext_pending;
+	int         publish_pending;
+	bool        register_pending;
+	bool        panic_reset;
+	bool        cmd_pending;
+	bool        reboot_pending;
+	bool        reset_pending;
+	bool        hang_pending;
+	bool        watchdog;
+	bool        watchdog_armed;
+	unsigned    watchdog_ms;
+	unsigned    reset_mode;
+	vm_offset_t pshold;
+	vm_offset_t wdt;
+	vm_offset_t imem;
+	uint32_t _Atomic poll_lock;
+	uint64_t    tx_pos;                  /* ring reader position */
+	uint64_t    events, chars, rx_bytes;
+	uint64_t    commands;
+	uint64_t    timer_ticks;
+	uint32_t    mps;
+	uint32_t    setups;
+	uint32_t    ep0_active_ep;
+	uint32_t    resource[6];
+	uint32_t    event_complete[6];
+	uint32_t    event_inprogress[6];
+	uint32_t    event_notready[6];
+	uint32_t    last_event[6];
+	char        cmd[PU_CMD_SIZE];
+	uint32_t    cmd_len;
+	uint32_t    rx_len;
+	uint32_t    reboot_wait;
+} ud;
+
+struct ud_diag {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t size;
+	uint32_t state;
+	uint32_t mps;
+	uint32_t configured;
+	uint32_t ep0_busy;
+	uint32_t ep0_ready;
+	uint32_t ep0_active;
+	uint32_t tx_busy;
+	uint32_t rx_busy;
+	uint32_t rx_started;
+	uint32_t notify_busy;
+	uint32_t cmd_pending;
+	uint32_t setups;
+	uint32_t events;
+	uint32_t chars;
+	uint32_t rx_bytes;
+	uint32_t rx_len;
+	uint32_t resource[6];
+	uint32_t trb_out[4];
+	uint32_t trb_in[4];
+	uint32_t trb_rx[4];
+	uint32_t trb_tx[4];
+	uint32_t trb_notify[4];
+	uint64_t pur_total;
+	uint64_t pur_dropped;
+	uint64_t tx_pos;
+	uint32_t dalepena;
+	uint32_t devten;
+	uint32_t gctl;
+	uint32_t dctl;
+	uint32_t dsts;
+	uint32_t gevntcount;
+	uint32_t last_request;
+	uint32_t data_length;
+	uint32_t host_open;
+	uint32_t cmd_len;
+	uint32_t cmd_pending_snapshot;
+	uint32_t commands;
+	uint32_t setup_words[2];
+	uint32_t rx_words[8];
+	uint32_t cmd_words[20];
+	uint32_t event_complete[6];
+	uint32_t event_inprogress[6];
+	uint32_t event_notready[6];
+	uint32_t last_event[6];
+};
+
+static void ud_sync(uint32_t off, uint32_t len);
+static uint32_t dwc_rd(uint32_t off);
+
+static void
+ud_diag_trb(uint32_t offset, uint32_t out[4])
+{
+	volatile uint32_t *trb = (volatile uint32_t *)(ud.dma + offset);
+
+	ud_sync(offset, 16);
+	for (unsigned i = 0; i < 4; i++) {
+		out[i] = trb[i];
+	}
+}
+
+static void
+ud_diag_snapshot(struct ud_diag *diag)
+{
+	memset(diag, 0, sizeof(*diag));
+	diag->magic = UD_DIAG_MAGIC;
+	diag->version = 1;
+	diag->size = sizeof(*diag);
+	diag->state = ud.state;
+	diag->mps = ud.mps;
+	diag->configured = ud.configured;
+	diag->ep0_busy = ud.ep0_busy;
+	diag->ep0_ready = ud.ep0_ready;
+	diag->ep0_active = ud.ep0_active_ep;
+	diag->tx_busy = ud.tx_busy;
+	diag->rx_busy = ud.rx_busy;
+	diag->rx_started = ud.rx_transfer_started;
+	diag->notify_busy = ud.notify_busy;
+	diag->cmd_pending = ud.cmd_pending;
+	diag->setups = ud.setups;
+	diag->events = (uint32_t)ud.events;
+	diag->chars = (uint32_t)ud.chars;
+	diag->rx_bytes = ud.rx_bytes;
+	diag->rx_len = ud.rx_len;
+	memcpy(diag->resource, ud.resource, sizeof(diag->resource));
+	ud_diag_trb(UD_TRB_OUT, diag->trb_out);
+	ud_diag_trb(UD_TRB_IN, diag->trb_in);
+	ud_diag_trb(UD_TRB_RX, diag->trb_rx);
+	ud_diag_trb(UD_TRB_TX, diag->trb_tx);
+	ud_diag_trb(UD_TRB_NOTIFY, diag->trb_notify);
+	diag->pur_total = pur_ring.total;
+	diag->pur_dropped = os_atomic_load(&pur_dropped, relaxed);
+	diag->tx_pos = ud.tx_pos;
+	diag->dalepena = dwc_rd(DALEPENA);
+	diag->devten = dwc_rd(DEVTEN);
+	diag->gctl = dwc_rd(GCTL);
+	diag->dctl = dwc_rd(DCTL);
+	diag->dsts = dwc_rd(DSTS);
+	diag->gevntcount = dwc_rd(GEVNTCOUNT) & 0xffffu;
+	diag->last_request = ud.last_request;
+	diag->data_length = ud.data_length;
+	diag->host_open = ud.host_open;
+	diag->cmd_len = ud.cmd_len;
+	diag->cmd_pending_snapshot = ud.cmd_pending;
+	diag->commands = (uint32_t)ud.commands;
+	ud_sync(UD_SETUP, 8);
+	memcpy(diag->setup_words, (const void *)(ud.dma + UD_SETUP),
+	    sizeof(diag->setup_words));
+	ud_sync(UD_RX, sizeof(diag->rx_words));
+	memcpy(diag->rx_words, (const void *)(ud.dma + UD_RX),
+	    sizeof(diag->rx_words));
+	memcpy(diag->cmd_words, ud.cmd, sizeof(diag->cmd_words));
+	memcpy(diag->event_complete, ud.event_complete,
+	    sizeof(diag->event_complete));
+	memcpy(diag->event_inprogress, ud.event_inprogress,
+	    sizeof(diag->event_inprogress));
+	memcpy(diag->event_notready, ud.event_notready,
+	    sizeof(diag->event_notready));
+	memcpy(diag->last_event, ud.last_event, sizeof(diag->last_event));
+}
+
+static inline uint32_t
+usb_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+usb_wr(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint64_t
+picasso_usb_counter(void)
+{
+	uint64_t value;
+	__asm__ volatile ("isb" ::: "memory");
+	__asm__ volatile ("mrs %0, cntvct_el0" : "=r" (value) :: "memory");
+	return value;
+}
+
+static inline uint64_t
+picasso_usb_counter_frequency(void)
+{
+	uint64_t value;
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (value));
+	return value;
+}
+
+static void picasso_usb_emergency_fastboot(const char *reason);
+
+/*
+ * delay() can block on this early boot path before the scheduler is usable.
+ * r21 kernel bisection vs v5: restore the v5 bounded ARM yield loop.
+ * The cntvct-based rewrite is the prime suspect for the 38-40 s death
+ * (every DWC3/handoff/control delay changed timing). Counter helpers stay
+ * for the control-loop deadline reads; the wait itself does no counter I/O.
+ */
+static void
+picasso_usb_busy_wait(unsigned usec)
+{
+	while (usec-- != 0) {
+		for (unsigned spin = 0; spin < 4096; spin++) {
+			__asm__ volatile ("yield" ::: "memory");
+		}
+	}
+}
+
+static unsigned
+picasso_smmu_addr_bits(unsigned code)
+{
+	switch (code) {
+	case 0: return 32;
+	case 1: return 36;
+	case 2: return 40;
+	case 3: return 42;
+	case 4: return 44;
+	case 5: return 48;
+	default: return 0;
+	}
+}
+
+static inline void
+picasso_usb_smmu_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+picasso_usb_sync_mark(const char *text)
+{
+	while (*text != '\0') {
+		console_write_unbuffered(*text++);
+	}
+	console_write_unbuffered('\n');
+}
+
+static void
+picasso_usb_sync_mark_index(const char *text, unsigned index)
+{
+	char digits[10];
+	unsigned count = 0;
+
+	while (*text != '\0') {
+		console_write_unbuffered(*text++);
+	}
+	do {
+		digits[count++] = (char)('0' + index % 10);
+		index /= 10;
+	} while (index != 0);
+	while (count != 0) {
+		console_write_unbuffered(digits[--count]);
+	}
+	console_write_unbuffered('\n');
+}
+
+static void
+picasso_usb_sync_hex(const char *text, uint32_t value)
+{
+	static const char hex[] = "0123456789abcdef";
+
+	while (*text != '\0') {
+		console_write_unbuffered(*text++);
+	}
+	console_write_unbuffered('0');
+	console_write_unbuffered('x');
+	for (int shift = 28; shift >= 0; shift -= 4) {
+		console_write_unbuffered(hex[(value >> shift) & 0xfu]);
+	}
+	console_write_unbuffered('\n');
+}
+
+/*
+ * Read-only QSCRATCH diagnostics. Each access has a synchronous breadcrumb
+ * before it, so the last visible line identifies a stalled interconnect read.
+ */
+static void
+picasso_usb_qscratch_probe(vm_offset_t qs)
+{
+	picasso_usb_sync_mark("PICASSO USB: QPROBE enter");
+	picasso_usb_busy_wait(1000);
+
+	picasso_usb_sync_mark("PICASSO USB: QPROBE GENERAL_CFG read begin");
+	uint32_t general = usb_rd(qs, QSCRATCH_GENERAL_CFG);
+	picasso_usb_sync_hex("PICASSO USB: QPROBE GENERAL_CFG=", general);
+
+	picasso_usb_sync_mark("PICASSO USB: QPROBE HS_PHY_CTRL read begin");
+	uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL);
+	picasso_usb_sync_hex("PICASSO USB: QPROBE HS_PHY_CTRL=", hs);
+
+	picasso_usb_sync_mark("PICASSO USB: QPROBE SS_PHY_CTRL read begin");
+	uint32_t ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
+	picasso_usb_sync_hex("PICASSO USB: QPROBE SS_PHY_CTRL=", ss);
+
+	picasso_usb_sync_mark("PICASSO USB: QPROBE CGCTL read begin");
+	uint32_t cgctl = usb_rd(qs, QSCRATCH_CGCTL);
+	picasso_usb_sync_hex("PICASSO USB: QPROBE CGCTL=", cgctl);
+
+	picasso_usb_sync_mark("PICASSO USB: QPROBE PWR_EVT_STAT read begin");
+	uint32_t pwr_stat = usb_rd(qs, QSCRATCH_PWR_EVT_STAT);
+	picasso_usb_sync_hex("PICASSO USB: QPROBE PWR_EVT_STAT=", pwr_stat);
+
+	picasso_usb_sync_mark("PICASSO USB: QPROBE PWR_EVT_MASK read begin");
+	uint32_t pwr_mask = usb_rd(qs, QSCRATCH_PWR_EVT_MASK);
+	picasso_usb_sync_hex("PICASSO USB: QPROBE PWR_EVT_MASK=", pwr_mask);
+
+	picasso_usb_sync_mark("PICASSO USB: QPROBE GENERAL_CFG2 read begin");
+	uint32_t general2 = usb_rd(qs, QSCRATCH_GENERAL_CFG);
+	picasso_usb_sync_hex("PICASSO USB: QPROBE GENERAL_CFG2=", general2);
+	picasso_usb_sync_mark("PICASSO USB: QPROBE complete");
+}
+
+/*
+ * Minimal read-only experiment for the SMMU register block. The plan/apply
+ * path stays untouched; synchronous breadcrumbs are emitted immediately
+ * before each read so a bus hang identifies the exact register even when the
+ * buffered console cannot drain.
+ */
+static bool
+picasso_usb_smmu_probe_page(vm_offset_t smmu)
+{
+	picasso_usb_sync_mark("PICASSO USB: PROBE enter");
+	picasso_usb_sync_mark("PICASSO USB: PROBE sCR0 begin");
+	uint32_t scr0 = usb_rd(smmu, 0x000);
+	picasso_usb_sync_mark("PICASSO USB: PROBE sCR0 ok");
+	printf("PICASSO USB: SMMU probe sCR0=%08x\n", scr0);
+
+	picasso_usb_sync_mark("PICASSO USB: PROBE sGFSR begin");
+	uint32_t gfsr = usb_rd(smmu, 0x048);
+	picasso_usb_sync_mark("PICASSO USB: PROBE sGFSR ok");
+	printf("PICASSO USB: SMMU probe sGFSR=%08x\n", gfsr);
+
+	picasso_usb_sync_mark("PICASSO USB: PROBE IDR begin");
+	uint32_t idr0 = usb_rd(smmu, 0x020);
+	uint32_t idr1 = usb_rd(smmu, 0x024);
+	uint32_t idr2 = usb_rd(smmu, 0x028);
+	picasso_usb_sync_mark("PICASSO USB: PROBE IDR ok");
+	printf("PICASSO USB: SMMU probe idr=%08x/%08x/%08x\n",
+	    idr0, idr1, idr2);
+
+	unsigned slots = idr0 & 0xffu;
+	if (!slots || slots > 128) {
+		printf("PICASSO USB: SMMU probe bad stream count=%u\n", slots);
+		return false;
+	}
+
+	unsigned active = 0;
+	unsigned free_slot = 0xffffu;
+	for (unsigned i = 0; i < slots; i++) {
+		picasso_usb_sync_mark_index("PICASSO USB: PROBE SMR begin ",
+		    i);
+		uint32_t smr = usb_rd(smmu, 0x800u + 4u * i);
+		if (smr & (1u << 31)) {
+			active++;
+		} else if (free_slot == 0xffffu) {
+			free_slot = i;
+		}
+	}
+	printf("PICASSO USB: SMMU probe complete active=%u free=%u\n",
+	    active, free_slot);
+	return true;
+}
+
+/*
+ * The Qualcomm firmware implements Linux's SMMU bypass quirk: a TYPE=BYPASS
+ * S2CR reads back as FAULT, while TYPE=TRANSLATE to a disabled
+ * S1_TRANS_S2_BYPASS context bank works. Bind only the USB SID, never change
+ * sCR0, and leave every other stream route untouched. This is explicitly a
+ * debug-boot operation and is lost on the next reset.
+ */
+struct picasso_usb_smmu_bind {
+	unsigned slot;
+	unsigned bank;
+	uint32_t cbar;
+	uint32_t cba2r;
+	uint32_t sctlr;
+	uint32_t sctlr_off;
+};
+
+static bool
+picasso_usb_smmu_plan_bind(vm_offset_t smmu,
+    struct picasso_usb_smmu_bind *plan, bool verbose)
+{
+	if (verbose) {
+		picasso_usb_sync_mark("PICASSO USB: PLAN sCR0 begin");
+	}
+	uint32_t scr0 = usb_rd(smmu, 0x000);
+	if (verbose) {
+		picasso_usb_sync_mark("PICASSO USB: PLAN sGFSR begin");
+	}
+	uint32_t gfsr = usb_rd(smmu, 0x048);
+	if (verbose) {
+		picasso_usb_sync_mark("PICASSO USB: PLAN IDR begin");
+	}
+	uint32_t idr0 = usb_rd(smmu, 0x020);
+	uint32_t idr1 = usb_rd(smmu, 0x024);
+	uint32_t idr2 = usb_rd(smmu, 0x028);
+	unsigned slots = idr0 & 0xffu;
+	unsigned banks = idr1 & 0xffu;
+	unsigned pages = 1u << (((idr1 >> 28) & 7u) + 1u);
+	bool exids = (idr0 & (1u << 8)) != 0;
+	unsigned active = 0, free_slot = 0xffffu;
+	uint8_t bank_users[128] = { 0 };
+	uint32_t smrs[128];
+
+	printf("PICASSO USB: SMMU bind scr0=%08x gfsr=%08x idr=%08x/%08x/%08x exids=%u\n",
+	    scr0, gfsr, idr0, idr1, idr2, exids);
+	if (!slots || slots > 128 || !banks || banks > 128 || pages > 128 ||
+	    (pages + banks) * 4096u > SMMU_SIZE) {
+		printf("PICASSO USB: SMMU bind unsupported geometry\n");
+		return false;
+	}
+	if (exids) {
+		printf("PICASSO USB: SMMU bind refuses EXIDS layout\n");
+		return false;
+	}
+
+	for (unsigned i = 0; i < slots; i++) {
+		if (verbose) {
+			picasso_usb_sync_mark_index(
+			    "PICASSO USB: PLAN SMR begin ", i);
+		} else if ((i & 15u) == 0) {
+			printf("PICASSO USB: SMMU bind scan smr %u/%u\n", i, slots);
+		}
+		smrs[i] = usb_rd(smmu, 0x800u + 4u * i);
+		if (smrs[i] & (1u << 31)) {
+			active++;
+		} else if (free_slot == 0xffffu) {
+			free_slot = i;
+		}
+	}
+	printf("PICASSO USB: SMMU bind smr active=%u free=%u\n",
+	    active, free_slot);
+	if (free_slot == 0xffffu) {
+		printf("PICASSO USB: SMMU bind no free stream-match slot\n");
+		return false;
+	}
+
+	for (unsigned i = 0; i < slots; i++) {
+		if (!(smrs[i] & (1u << 31))) {
+			continue;
+		}
+		if (verbose) {
+			picasso_usb_sync_mark_index(
+			    "PICASSO USB: PLAN S2CR begin ", i);
+		}
+		uint32_t s2cr = usb_rd(smmu, 0xc00u + 4u * i);
+		if (((s2cr >> 16) & 3u) == 0 && (s2cr & 0xffu) < banks) {
+			bank_users[s2cr & 0xffu]++;
+		}
+	}
+	printf("PICASSO USB: SMMU bind s2cr scan done\n");
+
+	for (unsigned attempt = 0; attempt < banks; attempt++) {
+		unsigned bank = banks - 1 - attempt;
+		if (bank_users[bank]) {
+			printf("PICASSO USB: SMMU bank %u users=%u skip\n",
+			    bank, bank_users[bank]);
+			continue;
+		}
+		if (verbose) {
+			picasso_usb_sync_mark_index(
+			    "PICASSO USB: PLAN bank begin ", bank);
+		}
+		printf("PICASSO USB: SMMU bank %u probe\n", bank);
+		uint32_t cbar = usb_rd(smmu, 0x1000u + 4u * bank);
+		printf("PICASSO USB: SMMU bank %u cbar=%08x\n", bank, cbar);
+		uint32_t cba2r = usb_rd(smmu, 0x1800u + 4u * bank);
+		printf("PICASSO USB: SMMU bank %u cba2r=%08x\n", bank, cba2r);
+		uint32_t sctlr = usb_rd(smmu, (pages + bank) * 4096u);
+		printf("PICASSO USB: SMMU bank %u sctlr=%08x M=%u\n",
+		    bank, sctlr, sctlr & 1u);
+		if ((sctlr & 1u) != 0 ||
+		    (cbar != 0 && cbar != 0x10000u)) {
+			continue;
+		}
+
+		plan->slot = free_slot;
+		plan->bank = bank;
+		plan->cbar = cbar;
+		plan->cba2r = cba2r | 1u;
+		plan->sctlr = sctlr;
+		plan->sctlr_off = (pages + bank) * 4096u;
+		printf("PICASSO USB: SMMU bind plan slot=%u bank=%u\n",
+		    plan->slot, plan->bank);
+		return true;
+	}
+	printf("PICASSO USB: SMMU bind found no disabled bypass bank\n");
+	return false;
+}
+
+static bool
+picasso_usb_smmu_apply_bind(vm_offset_t smmu,
+    const struct picasso_usb_smmu_bind *plan)
+{
+	printf("PICASSO USB: SMMU bind apply slot=%u bank=%u\n",
+	    plan->slot, plan->bank);
+	if (plan->cbar != 0x10000u) {
+		picasso_usb_smmu_write(smmu, 0x1000u + 4u * plan->bank,
+		    0x10000u);
+	}
+	picasso_usb_smmu_write(smmu, 0x1800u + 4u * plan->bank,
+	    plan->cba2r);
+	uint32_t sctlr_after = usb_rd(smmu, plan->sctlr_off);
+	if (usb_rd(smmu, 0x1000u + 4u * plan->bank) != 0x10000u ||
+	    usb_rd(smmu, 0x1800u + 4u * plan->bank) != plan->cba2r ||
+	    sctlr_after != plan->sctlr) {
+		printf("PICASSO USB: SMMU bank %u setup readback FAIL\n",
+		    plan->bank);
+		return false;
+	}
+
+	picasso_usb_smmu_write(smmu, 0xc00u + 4u * plan->slot, plan->bank);
+	if (usb_rd(smmu, 0xc00u + 4u * plan->slot) != plan->bank) {
+		printf("PICASSO USB: SMMU bind S2CR readback FAIL\n");
+		return false;
+	}
+	picasso_usb_smmu_write(smmu, 0x800u + 4u * plan->slot,
+	    0x80000000u | USB_STREAM_ID);
+	uint32_t smr = usb_rd(smmu, 0x800u + 4u * plan->slot);
+	uint32_t s2cr = usb_rd(smmu, 0xc00u + 4u * plan->slot);
+	printf("PICASSO USB: SMMU bind route slot=%u smr=%08x s2cr=%08x bank=%u cbar=%08x cba2r=%08x sctlr=%08x\n",
+	    plan->slot, smr, s2cr, plan->bank, plan->cbar, plan->cba2r,
+	    plan->sctlr);
+	if (smr != (0x80000000u | USB_STREAM_ID) || s2cr != plan->bank) {
+		printf("PICASSO USB: SMMU bind route readback FAIL\n");
+		return false;
+	}
+	return true;
+}
+
+/*
+ * Read-only guard for the apps SMMU. A debug-only DMA path may use an
+ * existing direct/bypass route, but must never create or weaken one.
+ */
+static bool
+picasso_usb_smmu_guard(vm_offset_t smmu, uint64_t dma, uint64_t bytes)
+{
+	uint32_t scr0 = usb_rd(smmu, 0x000);
+	uint32_t idr0 = usb_rd(smmu, 0x020);
+	uint32_t idr1 = usb_rd(smmu, 0x024);
+	uint32_t idr2 = usb_rd(smmu, 0x028);
+	uint32_t gfsr = usb_rd(smmu, 0x048);
+	unsigned count = idr0 & 0xffu;
+	unsigned banks = idr1 & 0xffu;
+	unsigned pages = 1u << (((idr1 >> 28) & 7u) + 1u);
+	unsigned matches = 0;
+	unsigned match_index = 0;
+	uint32_t match_smr = 0;
+	uint32_t match_s2cr = 0;
+	uint32_t match_mask = 0;
+
+	printf("PICASSO USB: SMMU scr0=%08x idr=%08x/%08x/%08x gfsr=%08x\n",
+	    scr0, idr0, idr1, idr2, gfsr);
+	printf("PICASSO USB: SMMU streams=%u banks=%u pages=%u\n",
+	    count, banks, pages);
+	if (!count || !banks || pages > 128 ||
+	    (pages + banks) * 4096u > SMMU_SIZE) {
+		printf("PICASSO USB: SID e0 guard FAIL: unsupported SMMU geometry\n");
+		return false;
+	}
+
+	for (unsigned i = 0; i < count; i++) {
+		uint32_t smr = usb_rd(smmu, 0x800u + 4u * i);
+		if (!(smr & (1u << 31))) {
+			continue;
+		}
+		uint32_t mask = (smr >> 16) & 0x7fffu;
+		if (((smr ^ USB_STREAM_ID) & 0xffffu & ~mask) != 0) {
+			continue;
+		}
+		matches++;
+		if (matches <= 4) {
+			printf("PICASSO USB: SID e0 match %u smr=%08x s2cr=%08x\n",
+			    i, smr, usb_rd(smmu, 0xc00u + 4u * i));
+		}
+		if (matches == 1) {
+			match_index = i;
+			match_smr = smr;
+			match_mask = mask;
+			match_s2cr = usb_rd(smmu, 0xc00u + 4u * i);
+		}
+	}
+	if (matches != 1) {
+		printf("PICASSO USB: SID e0 guard FAIL: matches=%u (need exactly 1)\n",
+		    matches);
+		return false;
+	}
+	if (match_mask != 0) {
+		printf("PICASSO USB: SID e0 guard FAIL: non-exact mask=%04x\n",
+		    match_mask);
+		return false;
+	}
+
+	unsigned type = (match_s2cr >> 16) & 3u;
+	unsigned bank = match_s2cr & 0xffu;
+	uint32_t cbar = 0;
+	uint32_t cba2r = 0;
+	uint32_t sctlr = 0;
+	bool identity = false;
+
+	if (type == 0) {
+		if (bank >= banks) {
+			printf("PICASSO USB: SID e0 guard FAIL: cb=%u banks=%u\n",
+			    bank, banks);
+			return false;
+		}
+		cbar = usb_rd(smmu, 0x1000u + 4u * bank);
+		cba2r = usb_rd(smmu, 0x1800u + 4u * bank);
+		sctlr = usb_rd(smmu, (pages + bank) * 4096u);
+		identity = ((cbar >> 16) & 3u) == 1u && !(sctlr & 1u);
+	} else if (type == 1) {
+		identity = true;
+	}
+	printf("PICASSO USB: SID e0 match=%u smr=%08x s2cr=%08x type=%u cb=%u\n",
+	    match_index, match_smr, match_s2cr, type, bank);
+	printf("PICASSO USB: SID e0 cbar=%08x cba2r=%08x sctlr=%08x path=%s\n",
+	    cbar, cba2r, sctlr, identity ? "identity" : "not-identity");
+	if (!identity) {
+		printf("PICASSO USB: SID e0 guard FAIL: route is not direct identity\n");
+		return false;
+	}
+
+	unsigned in_bits = picasso_smmu_addr_bits(idr2 & 0xf);
+	unsigned out_bits = picasso_smmu_addr_bits((idr2 >> 4) & 0xf);
+	unsigned mid_bits = picasso_smmu_addr_bits((idr2 >> 8) & 0xf);
+	printf("PICASSO USB: SMMU widths in/out/mid=%u/%u/%u DMA=0x%llx+0x%llx\n",
+	    in_bits, out_bits, mid_bits, dma, bytes);
+	if (bytes) {
+		unsigned widths[3] = { in_bits, out_bits, mid_bits };
+		for (unsigned i = 0; i < 3; i++) {
+			if (!widths[i] || dma >= (1ULL << widths[i]) ||
+			    bytes > (1ULL << widths[i]) - dma) {
+				printf("PICASSO USB: SID e0 guard FAIL: DMA exceeds width %u\n",
+				    widths[i]);
+				return false;
+			}
+		}
+	}
+	printf("PICASSO USB: SID e0 guard PASS\n");
+	return true;
+}
+
+static inline void
+dwc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ud.dwc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+dwc_rd(uint32_t off)
+{
+	return usb_rd(ud.dwc, off);
+}
+
+static void
+ud_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(ud.dma_pa + off), len, TRUE);
+}
+
+static void
+ud_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ud.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	if (ud.trace_commands && !ud.panic_mode) {
+		printf("PICASSO USB: ep%u cmd %u prepare\n", ep, cmd);
+	}
+	/*
+	 * Issue one command and poll CMDACT, as Linux does. DEPCMD status 1 is
+	 * "no transfer resource", not "command ring full"; reissuing the same
+	 * STARTTRANSFER cannot make an active endpoint resource disappear.
+	 */
+	dwc_wr(DEPCMDPAR0(ep), p0);
+	dwc_wr(DEPCMDPAR1(ep), p1);
+	dwc_wr(DEPCMDPAR2(ep), p2);
+	*(volatile uint32_t *)(ud.dwc + DEPCMD(ep)) = cmd | DEPCMD_CMDACT;
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	for (unsigned poll = 0; poll < 5000; poll++) {
+		uint32_t value = dwc_rd(DEPCMD(ep));
+		if (!(value & DEPCMD_CMDACT)) {
+			uint32_t status = (value >> 12) & 0xf;
+			if (status != 0) {
+				if (!ud.panic_mode) {
+					printf("PICASSO USB: ep%u cmd %u status %u%s reg=0x%08x\n",
+					    ep, cmd, status,
+					    status == 1 ? " (no transfer resource)" : "",
+					    value);
+				}
+				return status == 1 ? UD_EPCMD_NO_RESOURCE : -1;
+			}
+			if (ud.trace_commands && !ud.panic_mode) {
+				printf("PICASSO USB: ep%u cmd %u complete reg=0x%08x polls=%u\n",
+				    ep, cmd, value, poll + 1);
+			}
+			if (cmd == DEPCMD_STARTTRANSFER) {
+				ud.resource[ep] = (value >> 16) & 0x7fu;
+			}
+			return 0;
+		}
+		picasso_usb_busy_wait(1);
+	}
+	if (!ud.panic_mode) {
+		printf("PICASSO USB: ep%u cmd %u timeout\n", ep, cmd);
+	}
+	return -1;
+}
+
+static int
+ud_epcmd_named(const char *name, unsigned ep, uint32_t cmd,
+    uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	int result = ud_epcmd(ep, cmd, p0, p1, p2);
+	if (!ud.panic_mode) {
+		printf("PICASSO USB: %s ep%u cmd=%u result=%d reg=0x%08x rsc=%u\n",
+		    name, ep, cmd & 0xfu, result, dwc_rd(DEPCMD(ep)), ud.resource[ep]);
+	}
+	return result;
+}
+
+static void
+ud_dump_ep_state(const char *tag, unsigned ep)
+{
+	volatile uint32_t *trb = NULL;
+	uint32_t trb_off = 0;
+	int result = ud_epcmd(ep, DEPCMD_GETEPSTATE, 0, 0, 0);
+	uint32_t state = dwc_rd(DEPCMDPAR2(ep));
+
+	if (ep == EP_RX) {
+		trb_off = UD_TRB_RX;
+	} else if (ep == EP_TX) {
+		trb_off = UD_TRB_TX;
+	} else if (ep == EP_NOTIFY) {
+		trb_off = UD_TRB_NOTIFY;
+	}
+	if (trb_off != 0) {
+		trb = (volatile uint32_t *)(ud.dma + trb_off);
+		ud_sync(trb_off, 16);
+		printf("PICASSO USB: EPSTATE %s ep%u result=%d state=0x%08x "
+		    "busy=%u rsc=%u trb=%08x/%08x/%08x/%08x "
+		    "DALEPENA=%08x DCTL=%08x DSTS=%08x events=%llu/%u\n",
+		    tag, ep, result, state,
+		    ep == EP_RX ? ud.rx_busy : ep == EP_TX ? ud.tx_busy :
+		    ep == EP_NOTIFY ? ud.notify_busy : 0u,
+		    ud.resource[ep], trb[0], trb[1], trb[2], trb[3],
+		    dwc_rd(DALEPENA), dwc_rd(DCTL), dwc_rd(DSTS),
+		    ud.events, dwc_rd(GEVNTCOUNT) & 0xffffu);
+		return;
+	}
+	printf("PICASSO USB: EPSTATE %s ep%u result=%d state=0x%08x "
+	    "busy=%u rsc=%u DALEPENA=%08x DCTL=%08x DSTS=%08x events=%llu/%u\n",
+	    tag, ep, result, state,
+	    ep == EP_RX ? ud.rx_busy : ep == EP_TX ? ud.tx_busy :
+	    ep == EP_NOTIFY ? ud.notify_busy : 0u,
+	    ud.resource[ep], dwc_rd(DALEPENA), dwc_rd(DCTL), dwc_rd(DSTS),
+	    ud.events, dwc_rd(GEVNTCOUNT) & 0xffffu);
+}
+
+static uint64_t
+ud_prepare_trb(uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl,
+    uint32_t flags)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
+	uint64_t bpa = ud.dma_pa + buf;
+
+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = len;
+	/*
+	 * Linux only sets ISP/IMI for isochronous transfers or OUT requests
+	 * with short_not_ok. None of this gadget's endpoints need it.
+	 */
+	t[3] = ctl | TRB_HWO | flags | TRB_IOC;
+	ud_sync(trb, 16);
+	if (len) {
+		ud_sync(buf, len);
+	}
+	return ud.dma_pa + trb;
+}
+
+/* One TRB (at DMA offset trb) on physical endpoint ep. */
+static int
+ud_start_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	if (ep <= 1 && ud.ep0_busy) {
+		unsigned active = ud.ep0_active_ep;
+		uint32_t resource = ud.resource[active];
+		uint32_t command = DEPCMD_ENDTRANSFER | DEPCMD_FORCE_RM |
+		    DEPCMD_CMDIOC | (resource << 16);
+		int result = ud_epcmd(active, command, 0, 0, 0);
+		if (!ud.panic_mode) {
+			printf("PICASSO USB: ep0 restart ended physical ep%u rsc=%u "
+			    "result=%d\n", active, resource, result);
+		}
+		ud.resource[active] = 0;
+		ud.ep0_busy = false;
+		ud.ep0_active_ep = 0;
+	}
+	uint64_t tpa = ud_prepare_trb(trb, buf, len, ctl, TRB_LST);
+	int result = ud_epcmd(ep, DEPCMD_STARTTRANSFER,
+	    (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+	if (result == 0 && ep <= 1) {
+		ud.ep0_busy = true;
+		ud.ep0_active_ep = ep;
+	}
+	return result;
+}
+
+static void
+ud_ep0_end_active(const char *reason)
+{
+	if (!ud.ep0_busy) {
+		return;
+	}
+	unsigned ep = ud.ep0_active_ep;
+	uint32_t resource = ud.resource[ep];
+	uint32_t command = DEPCMD_ENDTRANSFER | DEPCMD_FORCE_RM |
+	    DEPCMD_CMDIOC | (resource << 16);
+	int result = ud_epcmd(ep, command, 0, 0, 0);
+	if (!ud.panic_mode) {
+		printf("PICASSO USB: ep0 end active (%s) physical ep%u rsc=%u "
+		    "result=%d\n", reason, ep, resource, result);
+	}
+	ud.resource[ep] = 0;
+	ud.ep0_busy = false;
+	ud.ep0_active_ep = 0;
+}
+
+static void
+ud_data_endpoints_abort(void)
+{
+	const unsigned endpoints[] = { EP_RX, EP_TX, EP_NOTIFY };
+	for (unsigned i = 0; i < sizeof(endpoints) / sizeof(endpoints[0]); i++) {
+		unsigned ep = endpoints[i];
+		if (ud.resource[ep] != 0) {
+			uint32_t command = DEPCMD_ENDTRANSFER | DEPCMD_FORCE_RM |
+			    DEPCMD_CMDIOC | (ud.resource[ep] << 16);
+			int result = ud_epcmd(ep, command, 0, 0, 0);
+			if (!ud.panic_mode && result != 0) {
+				printf("PICASSO USB: reset abort ep%u failed result=%d\n",
+				    ep, result);
+			}
+		}
+		ud.resource[ep] = 0;
+	}
+	ud.tx_busy = false;
+	ud.rx_busy = false;
+	ud.rx_transfer_started = false;
+	ud.notify_busy = false;
+}
+
+static void
+ud_link_down_cleanup(void)
+{
+	ud_data_endpoints_abort();
+	ud.configured = false;
+	ud.host_open = false;
+	ud.cmd_len = 0;
+}
+
+/*
+ * An endpoint prestarted by the no-op transfer uses Update Transfer for all
+ * subsequent TRBs. Linux uses the No Response form without CMDACT/CMDIOC.
+ * For a non-stream bulk OUT endpoint Linux sets CSP and leaves LST clear.
+ */
+static int
+ud_update_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	(void)ud_prepare_trb(trb, buf, len, ctl, TRB_CSP);
+	uint32_t command = DEPCMD_UPDATETRANSFER | (ud.resource[ep] << 16);
+	*(volatile uint32_t *)(ud.dwc + DEPCMD(ep)) = command;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 0;
+}
+
+/*
+ * Linux primes every bulk/interrupt endpoint with a zeroed no-op TRB after
+ * DALEPENA.  DWC3 then treats subsequent No Response Update Transfer commands
+ * as normal endpoint activity instead of leaving the endpoint uninitialised.
+ */
+static int
+ud_noop_start(unsigned ep, uint32_t trb)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
+
+	t[0] = 0;
+	t[1] = 0;
+	t[2] = 0;
+	t[3] = 0;
+	ud_sync(trb, 16);
+	uint64_t tpa = ud.dma_pa + trb;
+	return ud_epcmd_named("rx-noop", ep, DEPCMD_STARTTRANSFER,
+	    (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+}
+
+/* Terminate the two-entry bulk OUT ring with a hardware-owned link TRB. */
+static void
+ud_init_rx_ring(void)
+{
+	volatile uint32_t *link = (volatile uint32_t *)(ud.dma + UD_TRB_RX_LINK);
+	uint64_t first = ud.dma_pa + UD_TRB_RX;
+
+	link[0] = (uint32_t)first;
+	link[1] = (uint32_t)(first >> 32);
+	link[2] = 0;
+	link[3] = TRB_HWO | TRBCTL_LINK;
+	ud_sync(UD_TRB_RX_LINK, 16);
+	if (!ud.panic_mode) {
+		printf("PICASSO USB: RX ring first=0x%llx link=0x%llx ctl=0x%08x\n",
+		    first, ud.dma_pa + UD_TRB_RX_LINK, link[3]);
+	}
+}
+
+/*
+ * USB reset is destructive to endpoint resource allocation on this controller.
+ * Rebuild EP0 from the databook sequence and only restore data endpoints if the
+ * host had already selected the configuration.
+ */
+static int
+ud_ep0_rebuild(const char *reason)
+{
+	bool restore_configured = ud.configured;
+
+	ud_ep0_end_active(reason);
+	if (restore_configured) {
+		ud_data_endpoints_abort();
+		ud.configured = false;
+	}
+	ud.ep0_ready = false;
+	ud.ep0_busy = false;
+	ud.ep0_active_ep = 0;
+	ud.resource[0] = 0;
+	ud.resource[1] = 0;
+	dwc_wr(DALEPENA, 0);
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) != 0 ||
+	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3),
+	    (1u << 8) | (1u << 10) | (0u << 25), 0) != 0 ||
+	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) != 0 ||
+	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3),
+	    (1u << 8) | (1u << 10) | (1u << 25), 0) != 0 ||
+	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) != 0) {
+		if (!ud.panic_mode) {
+			printf("PICASSO USB: ep0 rebuild failed (%s)\n", reason);
+		}
+		return -1;
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud.ep0_ready = true;
+	if (!ud.panic_mode) {
+		printf("PICASSO USB: ep0 resources rebuilt (%s), DALEPENA=0x%08x\n",
+		    reason, dwc_rd(DALEPENA));
+	}
+	if (restore_configured) {
+		ud_configure();
+	}
+	return 0;
+}
+
+static int
+ud_ep0_start_recovering(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len,
+    uint32_t ctl, const char *phase)
+{
+	unsigned saved_state = ud.state;
+	int result = ud_start_trb(ep, trb, buf, len, ctl);
+
+	if (result == UD_EPCMD_NO_RESOURCE &&
+	    ud_ep0_rebuild(phase) == 0) {
+		ud.state = saved_state;
+		result = ud_start_trb(ep, trb, buf, len, ctl);
+	}
+	return result;
+}
+
+static void
+ud_start_rx(void)
+{
+	if (!ud.configured || ud.rx_busy) {
+		return;
+	}
+	if (!ud.rx_transfer_started) {
+		/*
+		 * Linux primes every non-control endpoint with a zeroed no-op
+		 * STARTTRANSFER after DALEPENA. This assigns the resource index
+		 * used by subsequent no-response UPDATE_TRANSFER commands.
+		 */
+		ud_init_rx_ring();
+		int prime = ud_noop_start(EP_RX, UD_TRB_RX);
+		if (prime != 0 || ud.resource[EP_RX] == 0) {
+			if (!ud.panic_mode) {
+				printf("PICASSO USB: RX no-op prime failed result=%d rsc=%u\n",
+				    prime, ud.resource[EP_RX]);
+			}
+			return;
+		}
+		ud.rx_transfer_started = true;
+	}
+	ud.rx_len = UD_RX_SIZE;
+	ud.rx_busy = true;
+	int result = ud_update_trb(EP_RX, UD_TRB_RX, UD_RX, UD_RX_SIZE,
+	    TRBCTL_NORMAL);
+	if (!ud.panic_mode) {
+		printf("PICASSO USB: RX arm mps=%u len=%u trb=0x%llx result=%d "
+		    "cmd=0x%08x rsc=%u started=%u\n",
+		    ud.mps, UD_RX_SIZE, ud.dma_pa + UD_TRB_RX, result,
+		    dwc_rd(DEPCMD(EP_RX)), ud.resource[EP_RX],
+		    ud.rx_transfer_started ? 1u : 0u);
+		ud_dump_ep_state("after-arm", EP_RX);
+	}
+	if (result != 0) {
+		ud.rx_busy = false;
+	}
+}
+
+static void
+ud_start_setup(void)
+{
+	if (!ud.ep0_ready && ud_ep0_rebuild("setup") != 0) {
+		return;
+	}
+	ud.state = EP0_SETUP;
+	if (ud.trace_commands) {
+		printf("PICASSO USB: setup TRB prepare va %p pa 0x%llx\n",
+		    (void *)(ud.dma + UD_TRB_OUT), ud.dma_pa + UD_TRB_OUT);
+	}
+	int result = ud_ep0_start_recovering(0, UD_TRB_OUT, UD_SETUP, 8,
+	    TRBCTL_SETUP, "setup no-resource");
+	if (result != 0 && !ud.panic_mode) {
+		printf("PICASSO USB: setup STARTTRANSFER failed result=%d\n", result);
+	}
+	if (ud.trace_commands) {
+		printf("PICASSO USB: setup TRB command returned\n");
+	}
+}
+
+static void
+ud_stall(void)
+{
+	ud_ep0_end_active("stall");
+	ud_epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
+	ud_start_setup();
+}
+
+/* CDC-ACM descriptors. VID 0x1209/PID 0x0001 = pid.codes test ID. */
+static const uint8_t ud_dev_desc[18] = {
+	18, 1, 0x00, 0x02, 0x02, 0x00, 0x00, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+static const uint8_t ud_cfg_desc[67] = {
+	9, 2, 67, 0, 2, 1, 0, 0x80, 100,                /* config: 2 interfaces, 200 mA */
+	9, 4, 0, 0, 1, 0x02, 0x02, 0x01, 0,             /* control iface 0: CDC ACM */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
+	5, 0x24, 0x01, 0x00, 1,                         /* call management: data iface 1 */
+	4, 0x24, 0x02, 0x02,                            /* ACM: line coding/control-line requests */
+	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
+	7, 5, 0x82, 0x03, 0x10, 0x00, 16,               /* ep 0x82 interrupt IN, 16 bytes */
+	9, 4, 1, 0, 2, 0x0a, 0x00, 0x00, 0,             /* data iface 1 alt 0: bulk IN/OUT */
+	7, 5, 0x81, 0x02, 0x40, 0x00, 0,                /* ep 0x81 bulk IN, 64 */
+	7, 5, 0x01, 0x02, 0x40, 0x00, 0,                /* ep 0x01 bulk OUT, 64 */
+};
+static uint8_t ud_line_coding[7] = {
+	0x00, 0xc2, 0x01, 0x00, 0, 0, 8,                /* 115200 8N1 (informational on USB) */
+};
+static const char *const ud_strings[] = {
+	NULL, "picasso", "picasso XNU USB console", "PICASSO01",
+};
+
+static uint32_t
+ud_string(unsigned idx, uint8_t *out)
+{
+	if (idx == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;   /* en-US */
+		return 4;
+	}
+	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0])) {
+		return 0;
+	}
+	const char *str = ud_strings[idx];
+	uint32_t n = 2;
+	for (; *str && n < 126; str++) {
+		out[n++] = (uint8_t)*str;
+		out[n++] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
+
+/* SET_CONFIGURATION(1): configure the CDC notification and bulk endpoints. */
+static void
+ud_configure(void)
+{
+	int failed = 0;
+
+	if (ud.configured) {
+		return;
+	}
+	failed |= ud_epcmd_named("start-config", 0,
+	    DEPCMD_DEPSTARTCFG | (2u << 16), 0, 0, 0) != 0;
+	failed |= ud_epcmd_named("rx-config", EP_RX, DEPCMD_SETEPCONFIG,
+	    (2u << 1) | (ud.mps << 3),
+	    (1u << 8) | (1u << 9) | (EP_RX << 25), 0) != 0;
+	failed |= ud_epcmd_named("rx-resource", EP_RX,
+	    DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) != 0;
+	failed |= ud_epcmd_named("tx-config", EP_TX, DEPCMD_SETEPCONFIG,
+	    (2u << 1) | (ud.mps << 3) | (1u << 17),
+	    (1u << 8) | (1u << 9) | (EP_TX << 25), 0) != 0;
+	failed |= ud_epcmd_named("tx-resource", EP_TX,
+	    DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) != 0;
+	failed |= ud_epcmd_named("notify-config", EP_NOTIFY,
+	    DEPCMD_SETEPCONFIG, (3u << 1) | (16u << 3) | (2u << 17),
+	    (1u << 8) | (8u << 16) | (EP_NOTIFY << 25), 0) != 0;
+	failed |= ud_epcmd_named("notify-resource", EP_NOTIFY,
+	    DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) != 0;
+	if (failed) {
+		printf("PICASSO USB: data endpoints setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, 0x3u | (1u << EP_RX) | (1u << EP_TX) | (1u << EP_NOTIFY));
+	printf("PICASSO USB: endpoints enabled mps=%u DALEPENA=0x%08x\n",
+	    ud.mps, dwc_rd(DALEPENA));
+	ud.configured = true;
+	ud.tx_pos = pur_ring.total > PURing_SIZE ?
+	    pur_ring.total - PURing_SIZE : 0;
+	ud.tx_busy = false;
+	ud.rx_busy = false;
+	ud.notify_busy = false;
+	ud_dump_ep_state("pre-arm", EP_RX);
+	ud_start_rx();
+	printf("PICASSO USB: configured, streaming the console\n");
+	{
+		uint8_t *notification = (uint8_t *)(ud.dma + UD_NOTIFY);
+		notification[0] = 0xa1;       /* CDC class/interface, device-to-host */
+		notification[1] = 0x20;       /* SERIAL_STATE */
+		notification[2] = 0; notification[3] = 0;
+		notification[4] = 0; notification[5] = 0;
+		notification[6] = 2; notification[7] = 0;
+		notification[8] = 0; notification[9] = 0;
+		ud.notify_busy = true;
+		ud_start_trb(EP_NOTIFY, UD_TRB_NOTIFY, UD_NOTIFY, UD_NOTIFY_SIZE, TRBCTL_NORMAL);
+	}
+}
+
+static void
+ud_setup(void)
+{
+	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
+	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
+	uint8_t type = st[0], req = st[1];
+	uint16_t value = (uint16_t)(st[2] | st[3] << 8);
+	uint16_t index = (uint16_t)(st[4] | st[5] << 8);
+	uint16_t length = (uint16_t)(st[6] | st[7] << 8);
+	uint32_t n = 0;
+	bool ok = true;
+
+	ud.data_in = (type & 0x80) != 0;
+	ud.last_request = req;
+	ud.data_length = length;
+	if (ud.setups++ < 96) {
+		printf("PICASSO USB: setup type=%02x req=%02x value=%04x index=%04x len=%u\n",
+		    type, req, value, index, length);
+	}
+	if (type == 0xc0 && req == UD_DIAG_REQUEST && index == 0) {
+		struct ud_diag diag;
+		ud_diag_snapshot(&diag);
+		n = MIN((uint32_t)length, (uint32_t)sizeof(diag));
+		memcpy(data, &diag, n);
+	} else if ((type & 0x60) == 0x20) {   /* CDC class requests on control interface 0 */
+		if ((type & 0x1f) != 1 || index != 0) {
+			ok = false;
+		} else if (req == 0x20 && type == 0x21 && length == sizeof(ud_line_coding)) {
+			/* SET_LINE_CODING: copy the host's seven-byte OUT data stage below. */
+		} else if (req == 0x21 && type == 0xa1) {
+			memcpy(data, ud_line_coding, sizeof(ud_line_coding));
+			n = sizeof(ud_line_coding);
+		} else if (req == 0x22 && type == 0x21 && length == 0) {
+			/* SET_CONTROL_LINE_STATE: bit 0 tracks the host opening the port. */
+			bool was_open = ud.host_open;
+			ud.host_open = (value & 1u) != 0;
+			if (ud.host_open && !was_open && ud.configured) {
+				ud_dump_ep_state("host-open", EP_RX);
+			}
+		} else if (req == 0x23 && type == 0x21 && length == 0) {
+			/* SEND_BREAK: accepted, no device action. */
+		} else {
+			ok = false;
+		}
+	} else if ((type & 0x60) != 0) {
+		ok = false;
+	} else if (req == 6) {          /* GET_DESCRIPTOR */
+		switch (value >> 8) {
+		case 1: memcpy(data, ud_dev_desc, sizeof(ud_dev_desc)); n = sizeof(ud_dev_desc); break;
+		case 2:
+			memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc));
+			n = sizeof(ud_cfg_desc);
+			for (uint32_t i = 0; i + 5 < n && data[i] >= 2; i += data[i]) {
+				if (data[i + 1] == 5 && (data[i + 3] & 3u) == 2u) {
+					data[i + 4] = (uint8_t)ud.mps;
+					data[i + 5] = (uint8_t)(ud.mps >> 8);
+				}
+			}
+			break;
+		case 3: n = ud_string(value & 0xff, data); ok = n != 0; break;
+		default: ok = false; break;
+		}
+	} else if (req == 5) {          /* SET_ADDRESS */
+		uint32_t dcfg = dwc_rd(DCFG) & ~(0x7fu << 3);
+		dwc_wr(DCFG, dcfg | ((uint32_t)(value & 0x7f) << 3));
+	} else if (req == 9) {          /* SET_CONFIGURATION */
+		if (value == 1) {
+			ud_configure();
+		}
+	} else if (req == 8) {          /* GET_CONFIGURATION */
+		data[0] = ud.configured ? 1 : 0; n = 1;
+	} else if (req == 0) {          /* GET_STATUS */
+		data[0] = 0; data[1] = 0; n = 2;
+	} else if (req == 1 && type == 0x02 && value == 0 &&
+	    index != 0 && (index & 0x70) == 0) {
+		/* CLEAR_FEATURE(ENDPOINT_HALT), including macOS's open-time clear. */
+		unsigned ep = (index & 0x0f) * 2 + ((index >> 7) & 1);
+		if (ep >= 6) {
+			ok = false;
+		} else {
+			printf("PICASSO USB: clear halt ep=0x%02x phys=%u busy=%u rsc=%u\n",
+			    index, ep, ep == EP_RX ? ud.rx_busy :
+			    ep == EP_TX ? ud.tx_busy :
+			    ep == EP_NOTIFY ? ud.notify_busy : 0u, ud.resource[ep]);
+			if (ud.resource[ep] != 0) {
+				ud_epcmd(ep, DEPCMD_ENDTRANSFER | DEPCMD_FORCE_RM |
+				    (ud.resource[ep] << 16), 0, 0, 0);
+				ud.resource[ep] = 0;
+			}
+			if (ud_epcmd(ep, DEPCMD_CLEARSTALL, 0, 0, 0) != 0) {
+				ok = false;
+			} else {
+				if (ep == EP_RX) {
+					ud.rx_busy = false;
+					ud.rx_transfer_started = false;
+				} else if (ep == EP_TX) {
+					ud.tx_busy = false;
+				} else if (ep == EP_NOTIFY) {
+					ud.notify_busy = false;
+				}
+			}
+		}
+	} else if (req == 11 && (type & 0x1f) == 1 && index == 1 && value == 0) {
+		/* SET_INTERFACE: the sole data-interface alternate setting is zero. */
+	} else if (req == 10 && (type & 0x1f) == 1 && index == 1) {
+		data[0] = 0; n = 1;          /* GET_INTERFACE: alternate setting zero */
+	} else {
+		ok = false;
+	}
+	if (!ok) {
+		ud_stall();
+		return;
+	}
+	if (req == 1 && type == 0x02 && index == 0x01) {
+		ud_start_rx();
+	}
+	if (length == 0) {
+		ud.state = EP0_WAIT_STATUS2;
+		return;
+	}
+	ud.state = EP0_DATA;
+	if (ud.data_in) {
+		if (n > length) {
+			n = length;
+		}
+		ud_ep0_start_recovering(1, UD_TRB_IN, UD_DATA, n, TRBCTL_DATA,
+		    "data-in no-resource");
+	} else {
+		ud_ep0_start_recovering(0, UD_TRB_OUT, UD_DATA, length, TRBCTL_DATA,
+		    "data-out no-resource");
+	}
+}
+
+static void
+ud_tx_pump(void)
+{
+	if (!ud.configured || ud.tx_busy) {
+		return;
+	}
+	uint32_t n = 0;
+	if (ud.panic_mode) {
+		n = pup_copy((char *)(ud.dma + UD_TX), UD_TX_SIZE);
+		if (n == 0) {
+			return;
+		}
+	} else {
+		n = pur_copy(&ud.tx_pos, (char *)(ud.dma + UD_TX), UD_TX_SIZE);
+	}
+	if (n == 0) {
+		return;
+	}
+	ud.tx_busy = true;
+	ud.chars += n;
+	ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, n, TRBCTL_NORMAL);
+}
+
+static void
+ud_rx_consume(const uint8_t *data, uint32_t size)
+{
+	for (uint32_t i = 0; i < size; i++) {
+		char c = (char)data[i];
+		if (c == '\r' || c == '\n') {
+			if (ud.cmd_len != 0 && !ud.cmd_pending) {
+				ud.cmd[ud.cmd_len] = '\0';
+				ud.cmd_pending = true;
+			}
+			ud.cmd_len = 0;
+		} else if (c == '\b' || c == 0x7f) {
+			if (ud.cmd_len != 0) {
+				ud.cmd_len--;
+			}
+		} else if (c >= ' ' && c <= '~') {
+			if (ud.cmd_len + 1 < sizeof(ud.cmd)) {
+				ud.cmd[ud.cmd_len++] = c;
+			} else {
+				ud.cmd_len = 0;
+				printf("PICASSO CDC: command too long\n");
+			}
+		}
+	}
+}
+
+static void
+ud_event(uint32_t ev)
+{
+	if (ev & 1) {                   /* device event */
+		uint32_t type = (ev >> 8) & 0xf;
+		if (type == 1) {        /* USB reset */
+			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+			ud_link_down_cleanup();
+			if (ud_ep0_rebuild("usb reset") == 0) {
+				ud_start_setup();
+			}
+		} else if (type == 2) { /* connect done */
+			uint32_t speed = dwc_rd(DSTS) & 7;
+			ud.mps = speed == 0 ? 512u : 64u;
+			if (!ud.ep0_ready && ud_ep0_rebuild("connect done") == 0) {
+				ud_start_setup();
+			}
+			if (!ud.panic_mode) {
+				printf("PICASSO USB: connected, speed %u\n", speed);
+			}
+		} else if (type == 0) {
+			if (!ud.panic_mode) {
+				printf("PICASSO USB: disconnect\n");
+			}
+			ud_link_down_cleanup();
+			if (ud_ep0_rebuild("disconnect") == 0) {
+				ud_start_setup();
+			}
+		}
+		return;
+	}
+	unsigned ep = (ev >> 1) & 0x1f;
+	unsigned type = (ev >> 6) & 0xf;
+	unsigned status = (ev >> 12) & 0xf;
+	if (ep < 6) {
+		ud.last_event[ep] = ev;
+		if (type == 1) {
+			ud.event_complete[ep]++;
+		} else if (type == 2) {
+			ud.event_inprogress[ep]++;
+		} else if (type == 3) {
+			ud.event_notready[ep]++;
+		}
+	}
+	if (ep == EP_TX && type == 1) {         /* bulk IN complete */
+		ud.tx_busy = false;
+		return;
+	}
+	if (ep == EP_NOTIFY && type == 1) {    /* CDC interrupt notification complete */
+		ud.notify_busy = false;
+		return;
+	}
+	if (ep == EP_RX && (type == 1 || type == 2)) {
+		/* Linux completes a bulk TRB for both Complete and InProgress. */
+		ud.rx_busy = false;
+		ud_sync(UD_TRB_RX, 16);
+		volatile uint32_t *trb = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+		uint32_t remaining = trb[2];
+		struct pur_text diag = { .length = 0 };
+		pur_text_append(&diag, "PICASSO USB: RX event type=");
+		pur_text_u64(&diag, type);
+		pur_text_append(&diag, " status=0x");
+		pur_text_hex32(&diag, status);
+		pur_text_append(&diag, " rem=");
+		pur_text_u64(&diag, remaining);
+		pur_text_append(&diag, " len=");
+		pur_text_u64(&diag, ud.rx_len);
+		pur_text_append(&diag, " ctl=0x");
+		pur_text_hex32(&diag, trb[3]);
+		pur_text_append(&diag, " rsc=");
+		pur_text_u64(&diag, ud.resource[EP_RX]);
+		pur_text_append(&diag, "\r\n");
+		pur_emit_raw(diag.bytes, diag.length);
+		if (!(status & 1u) && remaining <= ud.rx_len) {
+			uint32_t received = ud.rx_len - remaining;
+			if (!ud.panic_mode) {
+				printf("PICASSO CDC: RX complete type=%u status=%x bytes=%u\n",
+				    type, status, received);
+			}
+			if (received != 0) {
+				ud_sync(UD_RX, received);
+				ud_rx_consume((const uint8_t *)(ud.dma + UD_RX), received);
+				ud.rx_bytes += received;
+			}
+		}
+		ud_start_rx();
+		return;
+	}
+	if (ep == EP_RX && type == 3) {        /* bulk OUT transfer not ready */
+		if (!ud.panic_mode) {
+			printf("PICASSO CDC: RX not-ready status=%x busy=%u rsc=%u\n",
+			    status, ud.rx_busy ? 1u : 0u, ud.resource[EP_RX]);
+		}
+		if (!ud.rx_busy) {
+			ud_start_rx();
+		}
+		return;
+	}
+	if (ep > 1) {
+		return;
+	}
+	if (type == 1 || type == 2) {   /* XferComplete or terminal InProgress */
+		if (!ud.ep0_busy || ud.ep0_active_ep != ep) {
+			return;
+		}
+		if (type == 2) {
+			uint32_t trb = ep == 0 ? UD_TRB_OUT : UD_TRB_IN;
+			ud_sync(trb, 16);
+			volatile uint32_t *control =
+			    (volatile uint32_t *)(ud.dma + trb);
+			if (control[3] & TRB_HWO) {
+				return;
+			}
+		}
+		ud.resource[ep] = 0;
+		ud.ep0_busy = false;
+		ud.ep0_active_ep = 0;
+		switch (ud.state) {
+		case EP0_SETUP:
+			ud_sync(UD_SETUP, 8);
+			ud_setup();
+			break;
+		case EP0_DATA:
+			if (!ud.data_in && ud.last_request == 0x20 &&
+			    ud.data_length == sizeof(ud_line_coding)) {
+				ud_sync(UD_DATA, ud.data_length);
+				memcpy(ud_line_coding, (const void *)(ud.dma + UD_DATA), sizeof(ud_line_coding));
+			}
+			ud.state = EP0_WAIT_STATUS3;
+			break;
+		case EP0_STATUS:
+			ud_start_setup();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+	if (type == 3 && status == 2) { /* XferNotReady, control status phase */
+		if (ud.state == EP0_WAIT_STATUS2 || ud.state == EP0_WAIT_STATUS3) {
+			uint32_t ctl = ud.state == EP0_WAIT_STATUS3 ? TRBCTL_STATUS3 : TRBCTL_STATUS2;
+			ud.state = EP0_STATUS;
+			ud_ep0_start_recovering(ep, ep ? UD_TRB_IN : UD_TRB_OUT,
+			    UD_DATA, 0, ctl, "status no-resource");
+		}
+	}
+}
+
+static void
+ud_poll_events(void)
+{
+	uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffffu;
+	if (count) {
+		ud_sync(UD_EVT, UD_EVT_SIZE);
+		for (uint32_t done = 0; done < count; done += 4) {
+			uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+			unsigned event_ep = (ev & 1) ? 0u : ((ev >> 1) & 0x1fu);
+			ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+			if (!ud.panic_mode &&
+			    (event_ep == EP_RX || ud.events < 200)) {
+				pur_emit_event(ud.events, event_ep, ev);
+			}
+			ud.events++;
+			ud_event(ev);
+		}
+		dwc_wr(GEVNTCOUNT, count);
+	}
+	if (ud.cmd_pending && !ud.panic_mode) {
+		ud_process_command();
+	}
+}
+
+static void
+ud_poll(void)
+{
+	ud_poll_events();
+	ud_tx_pump();
+}
+
+static bool
+ud_command_is(const char *command, const char *expected)
+{
+	while (*command != '\0' && *expected != '\0') {
+		char a = *command++;
+		char b = *expected++;
+		if (a >= 'A' && a <= 'Z') {
+			a = (char)(a - 'A' + 'a');
+		}
+		if (b >= 'A' && b <= 'Z') {
+			b = (char)(b - 'A' + 'a');
+		}
+		if (a != b) {
+			return false;
+		}
+	}
+	return *command == '\0' && *expected == '\0';
+}
+
+static uint64_t
+picasso_usb_deadline(unsigned milliseconds)
+{
+	uint64_t frequency = picasso_usb_counter_frequency();
+	if (frequency == 0 || milliseconds == 0) {
+		return 0;
+	}
+	return picasso_usb_counter() + frequency * milliseconds / 1000u;
+}
+
+static void
+picasso_usb_host_kick(void)
+{
+	if (ud.host_seen) {
+		ud.host_deadline = picasso_usb_deadline(ud.host_timeout_ms);
+	}
+}
+
+static void
+picasso_usb_host_ready(void)
+{
+	if (!ud.configured || !ud.host_open) {
+		return;
+	}
+	ud.host_seen = true;
+	ud.host_deadline = picasso_usb_deadline(ud.host_timeout_ms);
+	printf("PICASSO USB: host supervision armed timeout=%u ms\n",
+	    ud.host_timeout_ms);
+}
+
+static void
+picasso_usb_watchdog_pet(void)
+{
+	if (ud.watchdog_armed && ud.wdt != 0) {
+		usb_wr(ud.wdt, APSS_WDT_RST, 1);
+	}
+}
+
+static uint32_t
+picasso_usb_watchdog_ticks(unsigned milliseconds)
+{
+	uint64_t ticks = (uint64_t)milliseconds * APSS_WDT_RATE_HZ / 1000u;
+	if (ticks == 0) {
+		return 0;
+	}
+	/* Saturate before narrowing; overflow must never shorten the timeout. */
+	return ticks - 1u > APSS_WDT_COUNTER_MAX ?
+	       APSS_WDT_COUNTER_MAX : (uint32_t)(ticks - 1u);
+}
+
+static void
+picasso_usb_watchdog_arm(void)
+{
+	if (!ud.watchdog || ud.wdt == 0) {
+		return;
+	}
+	uint32_t ticks = picasso_usb_watchdog_ticks(ud.watchdog_ms);
+	usb_wr(ud.wdt, APSS_WDT_EN, 0);
+	usb_wr(ud.wdt, APSS_WDT_RST, 1);
+	usb_wr(ud.wdt, APSS_WDT_BARK, ticks);
+	usb_wr(ud.wdt, APSS_WDT_BITE, ticks);
+	usb_wr(ud.wdt, APSS_WDT_EN, 1);
+	uint32_t bark = usb_rd(ud.wdt, APSS_WDT_BARK);
+	uint32_t bite = usb_rd(ud.wdt, APSS_WDT_BITE);
+	uint32_t ctl = usb_rd(ud.wdt, APSS_WDT_EN);
+	ud.watchdog_armed = bark == ticks && bite == ticks && (ctl & 1u);
+	printf("PICASSO USB: APSS watchdog %s ticks=%u bark=%u bite=%u ctl=%u effective_ms=%u\n",
+	    ud.watchdog_armed ? "armed" : "REJECTED", ticks, bark, bite, ctl,
+	    ud.watchdog_ms);
+}
+
+static void
+picasso_usb_watchdog_disable(void)
+{
+	if (ud.wdt != 0) {
+		usb_wr(ud.wdt, APSS_WDT_EN, 0);
+	}
+	ud.watchdog_armed = false;
+}
+
+static bool
+picasso_usb_pshold_reset(void)
+{
+	if (ud.pshold == 0) {
+		ud.pshold = ml_io_map(PSHOLD_PA, PAGE_SIZE);
+	}
+	if (ud.pshold == 0) {
+		printf("PICASSO CDC: PSHOLD map failed pa=0x%x; reset skipped\n",
+		    PSHOLD_PA);
+		return false;
+	}
+	printf("PICASSO CDC: PSHOLD reset begin pa=0x%x va=%p\n",
+	    PSHOLD_PA, (void *)ud.pshold);
+	*(volatile uint32_t *)ud.pshold = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (;;) {
+		__asm__ volatile ("wfe" ::: "memory");
+	}
+}
+
+static bool
+picasso_usb_arm_fastboot_reason(void)
+{
+	if (ud.imem == 0) {
+		printf("PICASSO CDC: IMEM Fastboot reason unavailable\n");
+		return false;
+	}
+
+	uint32_t previous = usb_rd(ud.imem, IMEM_RESTART_REASON);
+	printf("PICASSO CDC: IMEM Fastboot reason arm pa=0x%x previous=0x%08x target=0x%08x\n",
+	    IMEM_PA + IMEM_RESTART_REASON, previous, IMEM_FASTBOOT_MODE);
+	usb_wr(ud.imem, IMEM_RESTART_REASON, IMEM_FASTBOOT_MODE);
+	uint32_t readback = usb_rd(ud.imem, IMEM_RESTART_REASON);
+	if (readback != IMEM_FASTBOOT_MODE) {
+		printf("PICASSO CDC: IMEM Fastboot reason readback mismatch=0x%08x\n",
+		    readback);
+		return false;
+	}
+	printf("PICASSO CDC: IMEM Fastboot reason armed readback=0x%08x\n",
+	    readback);
+	return true;
+}
+
+static void
+picasso_usb_psci_reset(void)
+{
+	/*
+	 * The device tree declares the PSCI conduit as SMC. Unlike an APSS
+	 * watchdog bite, this enters the same firmware reset path that has
+	 * already rebooted Picasso during the entry probes, so it should keep
+	 * the PMIC SOFT_SPARE reason DarwinBoot programmed.
+	 */
+	register uint64_t x0 __asm__("x0") = 0x84000009ull;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	__asm__ volatile ("msr daifset, #0xf" ::: "memory");
+	__asm__ volatile ("smc #0" : "+r" (x0)
+	    : "r" (x1), "r" (x2), "r" (x3)
+	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+	      "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	printf("PICASSO CDC: PSCI reset returned (x0=%llu); falling back\n",
+	    (unsigned long long)x0);
+}
+
+static void
+picasso_usb_watchdog_reset(void)
+{
+	if (ud.wdt == 0) {
+		ud.wdt = ml_io_map(APSS_WDT_PA, PAGE_SIZE);
+	}
+	/*
+	 * DarwinBoot has already preset the PMIC SOFT_SPARE reset reason.
+	 * Keep this path as a fallback for firmware where PSCI reset is not
+	 * available.
+	 */
+	if (ud.wdt != 0) {
+		/*
+		 * Match the vendor WatchDogTriggerBite() sequence exactly:
+		 * pet the running watchdog, replace BITE with the four-tick
+		 * value, then stop servicing it.  Re-arming first can make the
+		 * controller reload a long count when BITE is rewritten.
+		 */
+		if (!(usb_rd(ud.wdt, APSS_WDT_EN) & 1u)) {
+			uint32_t ticks = picasso_usb_watchdog_ticks(ud.watchdog_ms);
+			usb_wr(ud.wdt, APSS_WDT_BARK, ticks);
+			usb_wr(ud.wdt, APSS_WDT_BITE, ticks);
+			usb_wr(ud.wdt, APSS_WDT_EN, 1);
+			ud.watchdog_armed = true;
+		}
+		usb_wr(ud.wdt, APSS_WDT_RST, 1);
+		usb_wr(ud.wdt, APSS_WDT_BITE, APSS_WDT_FORCED_BITE);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		__asm__ volatile ("msr daifset, #0xf" ::: "memory");
+		for (;;) {
+			__asm__ volatile ("wfe" ::: "memory");
+		}
+	}
+}
+
+static void
+picasso_usb_host_fail_fastboot(void)
+{
+	if (ud.imem != 0) {
+		usb_wr(ud.imem, IMEM_RESTART_REASON, IMEM_FASTBOOT_MODE);
+	}
+	if (ud.wdt != 0) {
+		usb_wr(ud.wdt, APSS_WDT_RST, 1);
+		usb_wr(ud.wdt, APSS_WDT_BITE, APSS_WDT_FORCED_BITE);
+	} else if (ud.pshold != 0) {
+		*(volatile uint32_t *)ud.pshold = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	__asm__ volatile ("msr daifset, #0xf" ::: "memory");
+	for (;;) {
+		__asm__ volatile ("wfe" ::: "memory");
+	}
+}
+
+static void
+picasso_usb_watchdog_service(void)
+{
+	if (!ud.watchdog_armed || ud.host_deadline == 0) {
+		return;
+	}
+	if ((int64_t)(picasso_usb_counter() - ud.host_deadline) >= 0) {
+		picasso_usb_host_fail_fastboot();
+	}
+	picasso_usb_watchdog_pet();
+}
+
+void
+picasso_usb_timer_tick(void)
+{
+	ud.timer_ticks++;
+	if (ud.watchdog_armed) {
+		picasso_usb_watchdog_service();
+	}
+}
+
+static void
+picasso_usb_system_reset(void)
+{
+	printf("PICASSO CDC: reset begin mode=%u\n", ud.reset_mode);
+	(void)picasso_usb_arm_fastboot_reason();
+	if (ud.reset_mode == PICASSO_USB_RESET_PSCI) {
+		picasso_usb_psci_reset();
+	}
+	if (ud.reset_mode != PICASSO_USB_RESET_PSHOLD) {
+		picasso_usb_watchdog_reset();
+	}
+	printf("PICASSO CDC: reset fallback PSHOLD\n");
+	if (!picasso_usb_pshold_reset()) {
+		printf("PICASSO CDC: reset failed; console remains alive\n");
+	}
+}
+
+static void
+picasso_usb_emergency_fastboot(const char *reason)
+{
+	/*
+	 * This path must not call back into the USB poll path: it is invoked
+	 * from inside a bounded register/USB wait. Arm the firmware reason
+	 * first, then drive PSHOLD directly. The mapped registers were set up
+	 * before any DWC3 access, so this remains available during enumeration.
+	 */
+	if (ud.imem != 0) {
+		usb_wr(ud.imem, IMEM_RESTART_REASON, IMEM_FASTBOOT_MODE);
+	}
+	if (ud.pshold != 0) {
+		/*
+		 * Do not print before resetting. Console output can itself block
+		 * on this broken-early-boot path; reset availability is the only
+		 * guarantee this emergency path must preserve.
+		 */
+		*(volatile uint32_t *)ud.pshold = 0;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		__asm__ volatile ("msr daifset, #0xf" ::: "memory");
+		for (;;) {
+			__asm__ volatile ("wfe" ::: "memory");
+		}
+	}
+	printf("PICASSO USB: EMERGENCY reset unavailable (%s); PSHOLD not mapped\n",
+	    reason);
+}
+
+static bool
+ud_flush_console(unsigned polls, unsigned gap_usec)
+{
+	for (unsigned i = 0; i < polls; i++) {
+		ud_poll_events();
+		ud_tx_pump();
+		if (!ud.tx_busy && pur_ring.total == ud.tx_pos) {
+			return true;
+		}
+		picasso_usb_busy_wait(gap_usec);
+	}
+	return !ud.tx_busy && pur_ring.total == ud.tx_pos;
+}
+
+static void
+ud_finish_reboot(void)
+{
+	/*
+	 * Never make reset conditional on an infinitely busy console ring:
+	 * PICASSO USB events can append bytes while this drain is running.
+	 * Give the current output a short, fixed opportunity to leave, then
+	 * reset unconditionally. The IMEM Fastboot reason was armed above.
+	 */
+	(void)picasso_usb_arm_fastboot_reason();
+	printf("PICASSO CDC: fastboot flush begin tx_busy=%u pending=%llu\n",
+	    ud.tx_busy ? 1u : 0u, pur_ring.total - ud.tx_pos);
+	bool flushed = ud_flush_console(PICASSO_USB_FLUSH_POLLS,
+	    PICASSO_USB_FLUSH_GAP_US);
+	printf("PICASSO CDC: fastboot flush %s; entering configured reset path\n",
+	    flushed ? "complete" : "deadline");
+	(void)ud_flush_console(PICASSO_USB_FINAL_FLUSH_POLLS,
+	    PICASSO_USB_FLUSH_GAP_US);
+	picasso_usb_system_reset();
+}
+
+static void
+ud_finish_hang(void)
+{
+	/*
+	 * Deliberately stop the only CPU without masking the APSS watchdog.
+	 * This proves that a scheduler hang can still reset to Fastboot while
+	 * the host keeps the final CDC breadcrumbs.
+	 */
+	(void)picasso_usb_arm_fastboot_reason();
+	printf("PICASSO CDC: hang-test flush begin\n");
+	(void)ud_flush_console(PICASSO_USB_FLUSH_POLLS,
+	    PICASSO_USB_FLUSH_GAP_US);
+	printf("PICASSO CDC: hang-test CPU halt begin; awaiting watchdog\n");
+	(void)ud_flush_console(PICASSO_USB_FINAL_FLUSH_POLLS,
+	    PICASSO_USB_FLUSH_GAP_US);
+	__asm__ volatile ("msr daifset, #0xf" ::: "memory");
+	for (;;) {
+		__asm__ volatile ("wfe" ::: "memory");
+	}
+}
+
+static void
+ud_process_command(void)
+{
+	ud.cmd_pending = false;
+	ud.commands++;
+	picasso_usb_host_kick();
+	printf("PICASSO CDC: command '%s'\n", ud.cmd);
+	if (ud_command_is(ud.cmd, "help")) {
+		printf("PICASSO CDC: commands: help | ping | status | panic-test | reset-test | start-graphics | register-display | publish-display | publish-display-start | hang-test | reboot-fastboot\n");
+	} else if (ud_command_is(ud.cmd, "ping")) {
+		printf("PICASSO CDC: pong\n");
+	} else if (ud_command_is(ud.cmd, "status")) {
+		uint64_t now = picasso_usb_counter();
+		printf("PICASSO CDC: configured=%u host_open=%u host_seen=%u "
+		    "host_ms=%u live=%u panic=%u "
+		    "watchdog=%u armed=%u reset=%u events=%llu tx=%llu "
+		    "rx=%llu dropped=%llu timer=%llu now=%llu deadline=%llu\n",
+		    ud.configured ? 1u : 0u, ud.host_open ? 1u : 0u,
+		    ud.host_seen ? 1u : 0u, ud.host_timeout_ms,
+		    ud.live ? 1u : 0u, ud.panic_mode ? 1u : 0u,
+		    ud.watchdog ? 1u : 0u, ud.watchdog_armed ? 1u : 0u,
+		    ud.reset_mode, ud.events, ud.chars, ud.rx_bytes,
+		    os_atomic_load(&pur_dropped, relaxed), ud.timer_ticks,
+		    now, ud.host_deadline);
+	} else if (ud_command_is(ud.cmd, "panic-test")) {
+		printf("PICASSO CDC: panic-test requested; emitting marker now\n");
+		/*
+		 * ud_process_command() runs with poll_lock held. Defer the panic
+		 * until ud_poll_serialized() has released that lock; otherwise the
+		 * panic flush path would recursively drive the same DWC3 event ring.
+		 */
+		ud.panic_pending = true;
+	} else if (ud_command_is(ud.cmd, "start-graphics")) {
+		printf("PICASSO CDC: start-graphics requested; starting IOMobileGraphicsFamily\n");
+		ud.start_kext_pending = true;
+	} else if (ud_command_is(ud.cmd, "register-display")) {
+		printf("PICASSO CDC: register-display requested; running static init\n");
+		ud.register_pending = true;
+	} else if (ud_command_is(ud.cmd, "publish-display")) {
+		printf("PICASSO CDC: publish-display requested; allocate+init only\n");
+		ud.publish_pending = 1;
+	} else if (ud_command_is(ud.cmd, "publish-display-start")) {
+		printf("PICASSO CDC: publish-display-start requested; attach+start+register\n");
+		ud.publish_pending = 2;
+	} else if (ud_command_is(ud.cmd, "reset-test")) {
+		printf("PICASSO CDC: reset-test requested; draining then reset mode %u\n",
+		    ud.reset_mode);
+		ud.reset_pending = true;
+	} else if (ud_command_is(ud.cmd, "hang-test")) {
+		printf("PICASSO CDC: hang-test requested; stopping CPU and watchdog pets\n");
+		ud.hang_pending = true;
+	} else if (ud_command_is(ud.cmd, "reboot-fastboot")) {
+		printf("PICASSO CDC: reboot-fastboot requested; using reset mode %u\n",
+		    ud.reset_mode);
+		ud.reboot_pending = true;
+	} else if (ud.cmd[0] != '\0') {
+		printf("PICASSO CDC: unknown command '%s'; type help\n", ud.cmd);
+	}
+}
+
+static void
+pup_put(char c)
+{
+	if (pup_ring.total - pup_pos >= PU_PANIC_RING_SIZE) {
+		pup_pos++;
+	}
+	pup_ring.buffer[pup_ring.total & PU_PANIC_RING_MASK] = c;
+	pup_ring.total++;
+}
+
+static void
+pup_puts(const char *text, int size)
+{
+	for (int i = 0; i < size; i++) {
+		pup_put(text[i]);
+	}
+}
+
+void
+picasso_usb_panic_begin(void)
+{
+	static const char marker[] = "\r\n=== PICASSO CDC PANIC BEGIN ===\r\n";
+	if (pu_panic_active) {
+		return;
+	}
+	pu_panic_active = true;
+	ud.panic_mode = true;
+	pup_puts(marker, (int)(sizeof(marker) - 1));
+	picasso_usb_panic_flush();
+}
+
+void
+picasso_usb_panic_putc(char c)
+{
+	if (!pu_panic_active) {
+		return;
+	}
+	if (c == '\n') {
+		pup_put('\r');
+	}
+	pup_put(c);
+	if (c == '\n' || pup_ring.total - pup_pos >= 512) {
+		picasso_usb_panic_flush();
+	}
+}
+
+void
+picasso_usb_panic_write(const char *text, int size)
+{
+	if (!pu_panic_active || text == NULL || size <= 0) {
+		return;
+	}
+	for (int i = 0; i < size; i++) {
+		if (text[i] == '\n') {
+			pup_put('\r');
+		}
+		pup_put(text[i]);
+	}
+	if (size > 1 || text[size - 1] == '\n' ||
+	    pup_ring.total - pup_pos >= 512) {
+		picasso_usb_panic_flush();
+	}
+}
+
+void
+picasso_usb_panic_flush(void)
+{
+	if (!pu_panic_active || !ud.live || !ud.configured ||
+	    !os_atomic_cmpxchg(&pup_flush_lock, 0, 1, acquire)) {
+		return;
+	}
+	/* Try-lock only: a panic must never wait for a normal USB poller. */
+	if (!os_atomic_cmpxchg(&ud.poll_lock, 0, 1, acquire)) {
+		os_atomic_store(&pup_flush_lock, 0, release);
+		return;
+	}
+	for (unsigned i = 0; i < 20000; i++) {
+		ud_poll();
+		if (!ud.tx_busy && pup_ring.total == pup_pos) {
+			break;
+		}
+		picasso_usb_busy_wait(5);
+	}
+	os_atomic_store(&ud.poll_lock, 0, release);
+	os_atomic_store(&pup_flush_lock, 0, release);
+}
+
+void
+picasso_usb_panic_reset(void)
+{
+	if (!ud.panic_reset) {
+		return;
+	}
+
+	/*
+	 * The panic stream is already sent synchronously. Repeat the bounded
+	 * drain so the final backtrace/stackshot bytes reach the host before
+	 * the reset removes power from the USB controller.
+	 */
+	for (unsigned i = 0; i < 8; i++) {
+		picasso_usb_panic_flush();
+		picasso_usb_busy_wait(1000);
+	}
+	(void)picasso_usb_arm_fastboot_reason();
+	static const char reset_notice[] =
+	    "\r\n=== PICASSO CDC PANIC FLUSH COMPLETE: FASTBOOT REASON ARMED ===\r\n";
+	picasso_usb_panic_write(reset_notice, sizeof(reset_notice) - 1);
+	picasso_usb_panic_flush();
+	picasso_usb_system_reset();
+}
+
+static void
+ud_poll_serialized(void)
+{
+	if (!os_atomic_cmpxchg(&ud.poll_lock, 0, 1, acquire)) {
+		return;
+	}
+	ud_poll();
+	os_atomic_store(&ud.poll_lock, 0, release);
+	if (ud.start_kext_pending && !ud.panic_mode) {
+		ud.start_kext_pending = false;
+		extern kern_return_t native_start_kext_and_report(const char *,
+		    const char *) __attribute__((weak));
+		if (native_start_kext_and_report != 0) {
+			kern_return_t result = native_start_kext_and_report(
+			    "com.apple.iokit.IOMobileGraphicsFamily",
+			    "IOMobileFramebufferLegacy");
+			printf("PICASSO CDC: start-graphics result=%d\n", result);
+		} else {
+			printf("PICASSO CDC: start-graphics helper unavailable\n");
+		}
+	}
+	if (ud.register_pending && !ud.panic_mode) {
+		ud.register_pending = false;
+		extern kern_return_t native_register_display_and_report(void)
+		    __attribute__((weak));
+		if (native_register_display_and_report != 0) {
+			kern_return_t result = native_register_display_and_report();
+			printf("PICASSO CDC: register-display result=%d\n", result);
+		} else {
+			printf("PICASSO CDC: register-display helper unavailable\n");
+		}
+	}
+	if (ud.publish_pending && !ud.panic_mode) {
+		int level = ud.publish_pending - 1;
+		ud.publish_pending = 0;
+		extern kern_return_t native_publish_display_and_report(int)
+		    __attribute__((weak));
+		if (native_publish_display_and_report != 0) {
+			kern_return_t result =
+			    native_publish_display_and_report(level);
+			printf("PICASSO CDC: publish-display result=%d\n", result);
+		} else {
+			printf("PICASSO CDC: publish-display helper unavailable\n");
+		}
+	}
+	if (ud.reboot_pending && !ud.panic_mode) {
+		ud.reboot_pending = false;
+		ud_finish_reboot();
+	}
+	if (ud.hang_pending && !ud.panic_mode) {
+		ud.hang_pending = false;
+		ud_finish_hang();
+	}
+	if (ud.panic_pending && !ud.panic_mode) {
+		ud.panic_pending = false;
+		panic("PICASSO CDC PANIC TEST: synchronous panic capture is active");
+	}
+	if (ud.reset_pending && !ud.panic_mode) {
+		ud.reset_pending = false;
+		ud_finish_reboot();
+	}
+}
+
+static void
+picasso_usb_console_drive_poll(void)
+{
+	if (!pur_live || ud.hold) {
+		return;
+	}
+	ud_poll_serialized();
+}
+
+static void
+ud_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t polls = 0;
+
+	/*
+	 * The early Picasso timer path is not reliable yet.  A deadline-based
+	 * poller sleeps once and is never scheduled again, which also makes the
+	 * host-side bulk OUT endpoint look dead.  Keep the diagnostic console
+	 * runnable with a bounded spin and explicit yields instead.
+	 */
+	printf("PICASSO USB: busy poller started\n");
+	for (;;) {
+		ud_poll_serialized();
+		polls++;
+		if ((polls & 0x3ffu) == 0) {
+			picasso_usb_watchdog_service();
+		}
+		if ((polls % 4096) == 0) {
+			printf("PICASSO USB: poller heartbeat polls=%llu events=%llu rx_busy=%u\n",
+			    polls, ud.events, ud.rx_busy ? 1u : 0u);
+		}
+		picasso_usb_busy_wait(100);
+		thread_yield_internal(0);
+	}
+}
+
+static void
+picasso_usb_park(int hold)
+{
+	if (!hold) {
+		return;
+	}
+	if (!ud.watchdog_armed) {
+		picasso_usb_watchdog_arm();
+	}
+	printf("PICASSO USB: holding at bsd_init; SMMU guard %s\n",
+	    ud.smmu_guard ? "PASS" : "FAIL");
+	uint32_t panic_test_polls = 0;
+	for (;;) {
+		if (ud.live) {
+			ud_poll_serialized();
+			picasso_usb_watchdog_service();
+			if (ud.panic_test && ud.configured && ud.host_open &&
+			    ++panic_test_polls >= 1000) {
+				printf("PICASSO CDC: automatic panic-test after host attach\n");
+				panic("PICASSO CDC PANIC TEST: automatic capture is active");
+			}
+			picasso_usb_busy_wait(1000);
+		} else {
+			ud_sleep_ms(1000);
+			picasso_usb_watchdog_service();
+		}
+	}
+}
+
+static void
+picasso_usb_select_utmi_clk(vm_offset_t qs)
+{
+	picasso_usb_sync_mark("PICASSO USB: UTMI enter");
+	picasso_usb_sync_mark("PICASSO USB: UTMI before read begin");
+	uint32_t before = usb_rd(qs, QSCRATCH_GENERAL_CFG);
+	picasso_usb_sync_hex("PICASSO USB: UTMI before=", before);
+
+	picasso_usb_sync_mark("PICASSO USB: UTMI disable write begin");
+	usb_wr(qs, QSCRATCH_GENERAL_CFG, before | PIPE_UTMI_CLK_DIS);
+	picasso_usb_sync_mark("PICASSO USB: UTMI disable write done");
+	picasso_usb_busy_wait(5);
+	picasso_usb_sync_mark("PICASSO USB: UTMI disabled read begin");
+	uint32_t disabled = usb_rd(qs, QSCRATCH_GENERAL_CFG);
+	picasso_usb_sync_hex("PICASSO USB: UTMI disabled=", disabled);
+
+	picasso_usb_sync_mark("PICASSO USB: UTMI select write begin");
+	usb_wr(qs, QSCRATCH_GENERAL_CFG,
+	    disabled | PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW);
+	picasso_usb_sync_mark("PICASSO USB: UTMI select write done");
+	picasso_usb_busy_wait(5);
+	picasso_usb_sync_mark("PICASSO USB: UTMI selected read begin");
+	uint32_t selected = usb_rd(qs, QSCRATCH_GENERAL_CFG);
+	picasso_usb_sync_hex("PICASSO USB: UTMI selected=", selected);
+
+	picasso_usb_sync_mark("PICASSO USB: UTMI enable write begin");
+	usb_wr(qs, QSCRATCH_GENERAL_CFG, selected & ~PIPE_UTMI_CLK_DIS);
+	picasso_usb_sync_mark("PICASSO USB: UTMI enable write done");
+	picasso_usb_busy_wait(5);
+	picasso_usb_sync_mark("PICASSO USB: UTMI final read begin");
+	uint32_t after = usb_rd(qs, QSCRATCH_GENERAL_CFG);
+	picasso_usb_sync_hex("PICASSO USB: UTMI final=", after);
+
+	picasso_usb_sync_mark("PICASSO USB: UTMI complete");
+}
+
+static void
+picasso_usb_gadget_start(vm_offset_t dwc, vm_offset_t smmu)
+{
+	vm_offset_t qs;
+	uint32_t devid = usb_rd(dwc, 0xc120);
+	uint32_t hwparams0 = usb_rd(dwc, 0xc140);
+	unsigned awidth = hwparams0 >> 24;
+	uint32_t gctl = usb_rd(dwc, GCTL);
+
+	ud.dwc = dwc;
+	printf("PICASSO USB: controller id=%08x hwparams0=%08x awidth=%u gctl=%08x\n",
+	    devid, hwparams0, awidth, gctl);
+	printf("PICASSO USB: hwparams3..7=%08x %08x %08x %08x %08x\n",
+	    usb_rd(dwc, GHWPARAMS3), usb_rd(dwc, GHWPARAMS4),
+	    usb_rd(dwc, GHWPARAMS5), usb_rd(dwc, GHWPARAMS6),
+	    usb_rd(dwc, GHWPARAMS7));
+	printf("PICASSO USB: FIFO pre-reset rx0=%08x tx=%08x/%08x/%08x/%08x\n",
+	    usb_rd(dwc, GRXFIFOSIZ(0)), usb_rd(dwc, GTXFIFOSIZ(0)),
+	    usb_rd(dwc, GTXFIFOSIZ(1)), usb_rd(dwc, GTXFIFOSIZ(2)),
+	    usb_rd(dwc, GTXFIFOSIZ(3)));
+	if ((devid >> 16) != 0x5533 && (devid >> 16) != 0x3331) {
+		printf("PICASSO USB: unsupported DWC3 id; controller untouched\n");
+		return;
+	}
+	if (((gctl >> 12) & 3u) != 2u) {
+		printf("PICASSO USB: not in device mode; controller untouched\n");
+		return;
+	}
+	if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("PICASSO USB: no DMA memory\n");
+		return;
+	}
+	/* pmap_find_phys can return 0 for freshly kmem-allocated pages on this
+	 * kernel; kvtophys is the canonical VA-to-PA walk. Fail loudly either way. */
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)ud.dma);
+	uint64_t pa = pn ? ptoa_64(pn) : (uint64_t)kvtophys(ud.dma);
+	if (!pa) {
+		printf("PICASSO USB: cannot resolve DMA physical address at %p\n", (void *)ud.dma);
+		return;
+	}
+	ud.dma_pa = pa;
+	for (unsigned off = 0; off < UD_SIZE; off += PAGE_SIZE) {
+		ppnum_t page = pmap_find_phys(kernel_pmap, (addr64_t)(ud.dma + off));
+		if (!page || ptoa_64(page) != ud.dma_pa + off) {
+			printf("PICASSO USB: DMA is not physically contiguous at +0x%x\n",
+			    off);
+			return;
+		}
+	}
+	printf("PICASSO USB: DMA %d pages at va %p pa 0x%llx\n",
+	    (int)(UD_SIZE / PAGE_SIZE), (void *)ud.dma, ud.dma_pa);
+	ud.smmu_guard = picasso_usb_smmu_guard(smmu, ud.dma_pa, UD_SIZE);
+	if (!ud.smmu_guard) {
+		printf("PICASSO USB: SMMU guard refused; controller untouched\n");
+		return;
+	}
+	if (!awidth || awidth < 32 || (awidth < 64 &&
+	    ud.dma_pa + UD_SIZE > (1ULL << awidth))) {
+		printf("PICASSO USB: DMA exceeds DWC3 awidth=%u; controller untouched\n",
+		    awidth);
+		return;
+	}
+	printf("PICASSO USB: hardware guards PASS; issuing controller reset\n");
+	picasso_usb_watchdog_pet();
+	uint32_t usb2phy = usb_rd(dwc, GUSB2PHYCFG0);
+	uint32_t usb3pipe = usb_rd(dwc, GUSB3PIPECTL0);
+	printf("PICASSO USB: pre-stop GCTL=%08x DCFG=%08x DCTL=%08x DSTS=%08x USB2PHYCFG=%08x USB3PIPECTL=%08x\n",
+	    dwc_rd(GCTL), dwc_rd(DCFG), dwc_rd(DCTL), dwc_rd(DSTS), usb2phy,
+	    usb3pipe);
+	dwc_wr(DEVTEN, 0);
+	dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+	unsigned wait;
+	for (wait = 0; wait < 500 &&
+	    !(dwc_rd(DSTS) & DSTS_DEVCTRLHLT); wait++) {
+		picasso_usb_busy_wait(1000);
+	}
+	printf("PICASSO USB: pre-reset halt %s after %u ms DSTS=%08x\n",
+	    (dwc_rd(DSTS) & DSTS_DEVCTRLHLT) ? "done" : "TIMEOUT",
+	    wait, dwc_rd(DSTS));
+	if (!(dwc_rd(DSTS) & DSTS_DEVCTRLHLT)) {
+		return;
+	}
+	dwc_wr(GUSB2PHYCFG0, usb2phy &
+	    ~(GUSB2PHYCFG_SUSPHY | GUSB2PHYCFG_ENBLSLPM));
+	dwc_wr(GUSB3PIPECTL0, usb3pipe & ~GUSB3PIPECTL_SUSPHY);
+
+	printf("PICASSO USB: asserting soft reset\n");
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	printf("PICASSO USB: reset asserted, DCTL 0x%08x\n", dwc_rd(DCTL));
+	int i;
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		picasso_usb_busy_wait(1000);
+	}
+	printf("PICASSO USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
+	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return;
+	}
+	printf("PICASSO USB: FIFO post-reset rx0=%08x tx=%08x/%08x/%08x/%08x\n",
+	    usb_rd(dwc, GRXFIFOSIZ(0)), usb_rd(dwc, GTXFIFOSIZ(0)),
+	    usb_rd(dwc, GTXFIFOSIZ(1)), usb_rd(dwc, GTXFIFOSIZ(2)),
+	    usb_rd(dwc, GTXFIFOSIZ(3)));
+	picasso_usb_watchdog_pet();
+
+	qs = dwc + QSCRATCH_OFFSET;
+	printf("PICASSO USB: QSCRATCH %p (wrapper map %p + 0x%x)\n",
+	    (void *)qs, (void *)dwc, QSCRATCH_OFFSET);
+	picasso_usb_select_utmi_clk(qs);
+
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+	ud.trace_commands = true;
+	dwc_wr(DCFG, dwc_rd(DCFG) & ~(7u | (0x7fu << 3)));
+
+	if (ud_ep0_rebuild("initial") != 0) { return; }
+	picasso_usb_watchdog_pet();
+
+	uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL);
+	uint32_t ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
+	printf("PICASSO USB: QSCRATCH HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x\n", hs, ss);
+	usb_wr(qs, QSCRATCH_HS_PHY_CTRL,
+	    hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL);
+	usb_wr(qs, QSCRATCH_SS_PHY_CTRL, ss | LANE0_PWR_PRESENT);
+	printf("PICASSO USB: QSCRATCH after HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x\n",
+	    usb_rd(qs, QSCRATCH_HS_PHY_CTRL),
+	    usb_rd(qs, QSCRATCH_SS_PHY_CTRL));
+
+	ud_start_setup();
+	printf("PICASSO USB: setup TRB armed before RUN (%u retries)\n",
+	    (unsigned)usb_rd(dwc, DEPCMD(0)) >> 12 & 0xfu);
+	dwc_wr(DEVTEN, 0x7u | (1u << 9) | (1u << 11));
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		picasso_usb_busy_wait(1000);
+	}
+	if (dwc_rd(DSTS) & DSTS_DEVCTRLHLT) {
+		printf("PICASSO USB: controller remained halted; not starting EP0 DMA\n");
+		return;
+	}
+	ud.trace_commands = false;
+	printf("PICASSO USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n",
+	    dwc_rd(DSTS), i, ud.dma_pa);
+	ud.live = true;
+	pur_live = true;
+
+	static const unsigned sample_ms[] = { 0, 1, 10, 100, 500, 1000 };
+	uint64_t previous = ~0ULL;
+	unsigned elapsed_ms = 0;
+	for (unsigned s = 0; s < sizeof(sample_ms) / sizeof(sample_ms[0]); s++) {
+		if (sample_ms[s] > elapsed_ms) {
+			picasso_usb_busy_wait((sample_ms[s] - elapsed_ms) * 1000);
+			elapsed_ms = sample_ms[s];
+		}
+		ud_poll_serialized();
+		uint32_t dsts = dwc_rd(DSTS);
+		uint32_t dctl = dwc_rd(DCTL);
+		uint32_t phycfg = dwc_rd(GUSB2PHYCFG0);
+		uint32_t qcfg = usb_rd(qs, QSCRATCH_GENERAL_CFG);
+		uint32_t event_count = usb_rd(dwc, GEVNTCOUNT) & 0xffffu;
+		uint64_t state = ((uint64_t)dsts << 32) |
+		    ((uint64_t)(uint32_t)ud.events << 16) | event_count;
+		if (state != previous || s == 0 ||
+		    s + 1 == sizeof(sample_ms) / sizeof(sample_ms[0])) {
+			printf("PICASSO USB: STATE t=%ums DSTS=%08x speed=%u link=%u "
+			    "DCTL=%08x phy=%08x qcfg=%08x events=%llu/%u\n",
+			    elapsed_ms, dsts, dsts & 7u, (dsts >> 18) & 0xfu,
+			    dctl, phycfg, qcfg, ud.events, event_count);
+		}
+		previous = state;
+	}
+	if (!ud.hold) {
+		thread_t thread;
+		unsigned handoff_ms = 0;
+		while ((!ud.configured || !ud.host_open) && handoff_ms < 10000) {
+			picasso_usb_busy_wait(1000);
+			ud_poll_serialized();
+			picasso_usb_watchdog_service();
+			handoff_ms++;
+			if (ud.configured &&
+			    (handoff_ms <= 5 || handoff_ms % 1000 == 0)) {
+				ud_dump_ep_state("handoff", EP_RX);
+			}
+		}
+		printf("PICASSO USB: live handoff configured=%u host_open=%u after %u ms\n",
+		    ud.configured ? 1u : 0u, ud.host_open ? 1u : 0u, handoff_ms);
+		ud_poll_serialized();
+		picasso_usb_host_ready();
+		/*
+		 * Keep the early, synchronous control window open long enough for
+		 * the host to attach and issue commands. This path runs before the
+		 * timer-dependent background poller and UFS probe, so commands and
+		 * watchdog petting remain reliable even when those later paths hang.
+		 */
+		if (ud.control_ms != 0) {
+			printf("PICASSO USB: control window open for %u ms\n",
+			    ud.control_ms);
+			int timer_probe = 0;
+			extern void armcpu_timer_probe_now(void)
+			    __attribute__((weak));
+			if (PE_parse_boot_argn("native-timer-probe", &timer_probe,
+			    sizeof(timer_probe)) && timer_probe) {
+				if (armcpu_timer_probe_now != 0) {
+					armcpu_timer_probe_now();
+				} else {
+					printf("PICASSO TIMER: probe entry point unavailable; continuing\n");
+				}
+			}
+			/*
+			 * M1 stage C: minimal closed loop on INTID 19 (r24 proved it
+			 * is the live line). Begin with DAIF.I set: Group-1 the line,
+			 * enable the GIC path, re-arm the timer. Sample pending masked;
+			 * then unmask briefly and count taken IRQs; re-mask, disable
+			 * the source, report. Every wait iteration pets the watchdog.
+			 */
+			int selftest = 0;
+			extern void armcpu_timer_selftest_begin(void)
+			    __attribute__((weak));
+			extern void armcpu_timer_selftest_sample(unsigned)
+			    __attribute__((weak));
+			extern void armcpu_timer_selftest_go(void)
+			    __attribute__((weak));
+			extern void armcpu_timer_selftest_end(void)
+			    __attribute__((weak));
+			extern void armcpu_timer_sleep_test(void)
+			    __attribute__((weak));
+			if (PE_parse_boot_argn("native-timer-selftest", &selftest,
+			    sizeof(selftest)) && selftest) {
+				if (armcpu_timer_selftest_begin != 0) {
+					armcpu_timer_selftest_begin();
+				} else {
+					printf("PICASSO TIMER: selftest begin unavailable; continuing\n");
+				}
+				for (unsigned w = 0; w < 1500; w++) {
+					picasso_usb_busy_wait(1000);
+					ud_poll_serialized();
+					picasso_usb_watchdog_service();
+					if ((w + 1) % 100 == 0 &&
+					    armcpu_timer_selftest_sample != 0) {
+						armcpu_timer_selftest_sample(w + 1);
+					}
+				}
+				if (armcpu_timer_selftest_go != 0) {
+					armcpu_timer_selftest_go();
+				}
+				for (unsigned w = 0; w < 1500; w++) {
+					picasso_usb_busy_wait(1000);
+					ud_poll_serialized();
+					picasso_usb_watchdog_service();
+					if ((w + 1) % 100 == 0 &&
+					    armcpu_timer_selftest_sample != 0) {
+						armcpu_timer_selftest_sample(w + 1 + 1500);
+					}
+				}
+				if (armcpu_timer_sleep_test != 0) {
+					armcpu_timer_sleep_test();
+				}
+				if (armcpu_timer_selftest_end != 0) {
+					armcpu_timer_selftest_end();
+				}
+				printf("PICASSO TIMER: selftest done\n");
+			}
+			for (unsigned control_ms = 0;
+			    control_ms < ud.control_ms; control_ms++) {
+				if (ud.control_deadline != 0 &&
+				    (int64_t)(picasso_usb_counter() - ud.control_deadline) >= 0) {
+					printf("PICASSO USB: control reset deadline reached before poll; returning to Fastboot\n");
+					ud_finish_reboot();
+				}
+				picasso_usb_busy_wait(1000);
+				ud_poll_serialized();
+				picasso_usb_watchdog_service();
+				if (ud.control_reset &&
+				    ((ud.control_deadline != 0 &&
+				    (int64_t)(picasso_usb_counter() - ud.control_deadline) >= 0) ||
+				    control_ms + 1 >= ud.control_reset_ms)) {
+					printf("PICASSO USB: control reset deadline reached; returning to Fastboot\n");
+					ud_finish_reboot();
+				}
+				if (ud.configured &&
+				    ((control_ms + 1) % 10000 == 0)) {
+					printf("PICASSO USB: control window t=%ums events=%llu rx=%llu\n",
+					    control_ms + 1, ud.events, ud.rx_bytes);
+				}
+
+			}
+			printf("PICASSO USB: control window complete after %u ms\n",
+			    ud.control_ms);
+			ud_poll_serialized();
+		} else {
+			/* Preserve the old short settle when the window is disabled. */
+			for (unsigned settle_ms = 0; settle_ms < 500; settle_ms++) {
+				picasso_usb_busy_wait(1000);
+				ud_poll_serialized();
+				picasso_usb_watchdog_service();
+				if (settle_ms % 100 == 99) {
+					ud_dump_ep_state("settle", EP_RX);
+				}
+			}
+		}
+		if (ud.watchdog_armed) {
+			printf("PICASSO USB: APSS watchdog retained timeout=%u ms\n",
+			    ud.watchdog_ms);
+		}
+		kern_return_t result = kernel_thread_start(ud_thread, NULL, &thread);
+		if (result == KERN_SUCCESS) {
+			thread_deallocate(thread);
+			printf("PICASSO USB: background poller started\n");
+			ud_poll_serialized();
+		} else {
+			printf("PICASSO USB: background poller failed (%d); watchdog will reset\n",
+			    result);
+		}
+	}
+}
+
+void
+picasso_usb_console_start(void)
+{
+	int enabled = 0;
+	int hold = 0;
+	int bind_smmu = 0;
+	int panic_test = 0;
+	int panic_reset = 1;
+	int watchdog = 1;
+	int watchdog_ms = (int)APSS_WDT_TIMEOUT_MS;
+	int control_ms = PICASSO_USB_CONTROL_DEFAULT_MS;
+	int control_reset = 0;
+	int control_reset_ms = PICASSO_USB_CONTROL_RESET_DEFAULT_MS;
+	int host_timeout_ms = (int)PICASSO_USB_HOST_TIMEOUT_MS;
+	int host_boot_grace_ms = (int)PICASSO_USB_HOST_BOOT_GRACE_MS;
+	char reset_mode[16] = "psci";
+
+	PE_parse_boot_argn("picasso_usb", &enabled, sizeof(enabled));
+	PE_parse_boot_argn("picasso_usb_hold", &hold, sizeof(hold));
+	PE_parse_boot_argn("picasso_usb_smmu", &bind_smmu, sizeof(bind_smmu));
+	PE_parse_boot_argn("picasso_usb_panic_test", &panic_test,
+	    sizeof(panic_test));
+	PE_parse_boot_argn("picasso_usb_panic_reset", &panic_reset,
+	    sizeof(panic_reset));
+	PE_parse_boot_argn("picasso_usb_watchdog", &watchdog,
+	    sizeof(watchdog));
+	PE_parse_boot_argn("picasso_usb_watchdog_ms", &watchdog_ms,
+	    sizeof(watchdog_ms));
+	PE_parse_boot_argn("picasso_usb_control_ms", &control_ms,
+	    sizeof(control_ms));
+	PE_parse_boot_argn("picasso_usb_control_reset", &control_reset,
+	    sizeof(control_reset));
+	PE_parse_boot_argn("picasso_usb_control_reset_ms", &control_reset_ms,
+	    sizeof(control_reset_ms));
+	PE_parse_boot_argn("picasso_usb_host_timeout_ms", &host_timeout_ms,
+	    sizeof(host_timeout_ms));
+	PE_parse_boot_argn("picasso_usb_host_boot_grace_ms", &host_boot_grace_ms,
+	    sizeof(host_boot_grace_ms));
+	PE_parse_boot_argn("picasso_usb_reset", reset_mode,
+	    sizeof(reset_mode));
+	ud.mps = 64;
+	ud.hold = hold != 0;
+	ud.control_ms = control_ms > 0 ? (unsigned)control_ms : 0;
+	ud.control_reset = control_reset != 0 && ud.control_ms != 0;
+	if (control_reset_ms <= 0) {
+		control_reset_ms = PICASSO_USB_CONTROL_RESET_DEFAULT_MS;
+	}
+	ud.control_reset_ms = (unsigned)control_reset_ms;
+	if (ud.control_reset && ud.control_reset_ms > ud.control_ms) {
+		ud.control_reset_ms = ud.control_ms;
+	}
+	ud.panic_test = panic_test != 0;
+	ud.panic_reset = panic_reset != 0;
+	ud.watchdog = watchdog != 0;
+	if (watchdog_ms < 1000) {
+		watchdog_ms = (int)APSS_WDT_TIMEOUT_MS;
+	} else if (watchdog_ms > (int)APSS_WDT_MAX_TIMEOUT_MS) {
+		printf("PICASSO USB: watchdog requested_ms=%u exceeds 20-bit hardware; effective_ms=%u (software timeout required for longer waits)\n",
+		    (unsigned)watchdog_ms, APSS_WDT_MAX_TIMEOUT_MS);
+		watchdog_ms = (int)APSS_WDT_MAX_TIMEOUT_MS;
+	}
+	ud.watchdog_ms = (unsigned)watchdog_ms;
+	if (host_timeout_ms < 1000) {
+		host_timeout_ms = (int)PICASSO_USB_HOST_TIMEOUT_MS;
+	}
+	if (host_boot_grace_ms < 1000) {
+		host_boot_grace_ms = (int)PICASSO_USB_HOST_BOOT_GRACE_MS;
+	}
+	ud.host_timeout_ms = (unsigned)host_timeout_ms;
+	ud.host_boot_grace_ms = (unsigned)host_boot_grace_ms;
+	ud.host_seen = false;
+	if (strcmp(reset_mode, "watchdog") == 0) {
+		ud.reset_mode = PICASSO_USB_RESET_WATCHDOG;
+	} else if (strcmp(reset_mode, "pshold") == 0) {
+		ud.reset_mode = PICASSO_USB_RESET_PSHOLD;
+	} else {
+		ud.reset_mode = PICASSO_USB_RESET_PSCI;
+	}
+	if (!enabled) {
+		return;
+	}
+	ud.pshold = ml_io_map(PSHOLD_PA, PAGE_SIZE);
+	ud.wdt = ml_io_map(APSS_WDT_PA, PAGE_SIZE);
+	ud.imem = ml_io_map(IMEM_PA, PAGE_SIZE);
+	/*
+	 * Arm before any USB, SMMU or storage work.  If enumeration never
+	 * succeeds, the absent poller still returns the device to Fastboot.
+	 * The reason must be written now, not only on explicit commands:
+	 * a watchdog bite after enumeration failure has no code left to
+	 * program it, so an unarmed reason drops the board into Android.
+	 */
+	if (ud.imem != 0) {
+		usb_wr(ud.imem, IMEM_RESTART_REASON, IMEM_FASTBOOT_MODE);
+		uint32_t reason = usb_rd(ud.imem, IMEM_RESTART_REASON);
+		printf("PICASSO USB: Fastboot reason preset readback=0x%08x\n",
+		    reason);
+	}
+	/*
+	 * Start the escape clock before touching GCC, SMMU or DWC3. A later
+	 * enumeration failure must not remove the only path back to Fastboot:
+	 * every bounded wait checks this deadline and resets directly.
+	 */
+	uint64_t frequency = picasso_usb_counter_frequency();
+	if (frequency != 0) {
+		ud.host_deadline = picasso_usb_deadline(ud.host_boot_grace_ms);
+		printf("PICASSO USB: host boot grace armed for %u ms\n",
+		    ud.host_boot_grace_ms);
+		if (ud.control_reset) {
+			ud.control_deadline = picasso_usb_counter() +
+			    frequency * ud.control_reset_ms / 1000u;
+			printf("PICASSO USB: automatic Fastboot return armed for %u ms\n",
+			    ud.control_reset_ms);
+		}
+	}
+	picasso_usb_watchdog_arm();
+	picasso_usb_watchdog_pet();
+	if (!ud.watchdog_armed) {
+		printf("PICASSO USB: watchdog unavailable; autonomous reset disabled\n");
+	}
+	printf("PICASSO USB: PSHOLD mapped=%u panic-reset=%u watchdog=%u "
+	    "mapped=%u IMEM mapped=%u reset=%u(%s)\n",
+	    ud.pshold != 0 ? 1u : 0u, ud.panic_reset ? 1u : 0u,
+	    ud.watchdog ? 1u : 0u, ud.wdt != 0 ? 1u : 0u,
+	    ud.imem != 0 ? 1u : 0u, ud.reset_mode, reset_mode);
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	if (gcc == 0) {
+		printf("PICASSO USB: GCC map failed\n");
+		return;
+	}
+	uint32_t gdscr = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+	uint32_t master = usb_rd(gcc, GCC_USB30_PRIM_MASTER);
+	uint32_t sleep = usb_rd(gcc, GCC_USB30_PRIM_SLEEP);
+	uint32_t mock = usb_rd(gcc, GCC_USB30_PRIM_MOCK_UTMI);
+	uint32_t cfg = usb_rd(gcc, GCC_CFG_NOC_USB3_PRIM);
+	uint32_t aggre = usb_rd(gcc, GCC_AGGRE_USB3_PRIM);
+	uint32_t clkref = usb_rd(gcc, GCC_USB3_PRIM_CLKREF);
+	printf("PICASSO USB: GCC power=%08x master=%08x cfg=%08x aggre=%08x\n",
+	    gdscr, master, cfg, aggre);
+	printf("PICASSO USB: GCC sleep=%08x mock_utmi=%08x clkref=%08x\n",
+	    sleep, mock, clkref);
+	if (!(gdscr & (1u << 31)) || ((master | cfg | aggre) & (1u << 31))) {
+		printf("PICASSO USB: clocks/power unavailable; controller untouched\n");
+		picasso_usb_park(hold);
+		return;
+	}
+	vm_size_t smmu_size = bind_smmu == 2 ? PAGE_SIZE : SMMU_SIZE;
+	vm_offset_t smmu = ml_io_map(SMMU_PA, smmu_size);
+	if (smmu == 0) {
+		printf("PICASSO USB: SMMU map failed\n");
+		picasso_usb_park(hold);
+		return;
+	}
+	printf("PICASSO USB: SMMU mapped %u bytes\n", (unsigned)smmu_size);
+	if (bind_smmu == 3) {
+		ud.smmu_guard = picasso_usb_smmu_probe_page(smmu);
+		printf("PICASSO USB: SMMU probe pre-DWC full-map %s\n",
+		    ud.smmu_guard ? "PASS" : "FAIL");
+		picasso_usb_park(hold);
+		return;
+	}
+	vm_offset_t dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (dwc == 0) {
+		printf("PICASSO USB: DWC3 map failed\n");
+		picasso_usb_park(hold);
+		return;
+	}
+	ud.dwc = dwc;
+	printf("PICASSO USB: DWC3 GSNPSID 0x%08x GCTL 0x%08x DCTL 0x%08x DSTS 0x%08x DCFG 0x%08x\n",
+	    usb_rd(dwc, 0xc120), usb_rd(dwc, GCTL), usb_rd(dwc, DCTL),
+	    usb_rd(dwc, DSTS), usb_rd(dwc, DCFG));
+	if (bind_smmu == 7) {
+		vm_offset_t qs = dwc + QSCRATCH_OFFSET;
+		printf("PICASSO USB: QSCRATCH read-only probe pa=0x%x va=%p\n",
+		    QSCRATCH_PA, (void *)qs);
+		picasso_usb_qscratch_probe(qs);
+		picasso_usb_park(hold);
+		return;
+	}
+	if (bind_smmu == 4) {
+		ud.smmu_guard = picasso_usb_smmu_probe_page(smmu);
+		printf("PICASSO USB: SMMU probe post-DWC full-map %s\n",
+		    ud.smmu_guard ? "PASS" : "FAIL");
+		picasso_usb_park(hold);
+		return;
+	}
+	if (bind_smmu == 2) {
+		ud.smmu_guard = picasso_usb_smmu_probe_page(smmu);
+		printf("PICASSO USB: SMMU probe one-page %s\n",
+		    ud.smmu_guard ? "PASS" : "FAIL");
+		picasso_usb_park(hold);
+		return;
+	}
+	if (bind_smmu) {
+		struct picasso_usb_smmu_bind plan;
+		bool plan_only = bind_smmu == 5;
+		bool verbose_plan = bind_smmu == 5 || bind_smmu == 6;
+		if (!picasso_usb_smmu_plan_bind(smmu, &plan, verbose_plan)) {
+			printf("PICASSO USB: SMMU bind plan FAIL\n");
+			picasso_usb_park(hold);
+			return;
+		}
+		printf("PICASSO USB: SMMU bind plan PASS slot=%u bank=%u\n",
+		    plan.slot, plan.bank);
+		picasso_usb_watchdog_pet();
+		if (plan_only) {
+			picasso_usb_park(hold);
+			return;
+		}
+		printf("PICASSO USB: quiescing DWC3 before SMMU bind\n");
+		dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+		unsigned wait;
+		for (wait = 0; wait < 500 &&
+		    !(dwc_rd(DSTS) & DSTS_DEVCTRLHLT); wait++) {
+			picasso_usb_busy_wait(1000);
+		}
+		printf("PICASSO USB: DWC3 halt %s after %u ms DSTS=%08x\n",
+		    (dwc_rd(DSTS) & DSTS_DEVCTRLHLT) ? "done" : "TIMEOUT",
+		    wait, dwc_rd(DSTS));
+		if (!(dwc_rd(DSTS) & DSTS_DEVCTRLHLT) ||
+		    !picasso_usb_smmu_apply_bind(smmu, &plan)) {
+			printf("PICASSO USB: SMMU bind refused; controller untouched\n");
+			picasso_usb_park(hold);
+			return;
+		}
+	}
+	ud.smmu_guard = picasso_usb_smmu_guard(smmu, 0, 0);
+	if (!ud.smmu_guard) {
+		printf("PICASSO USB: SID e0 guard refused; controller untouched\n");
+		picasso_usb_park(hold);
+		return;
+	}
+	picasso_usb_watchdog_pet();
+	if (enabled >= 2) {
+		picasso_usb_gadget_start(dwc, smmu);
+	} else {
+		printf("PICASSO USB: route test complete; DWC3 remains halted\n");
+	}
+	picasso_usb_park(hold);
+}
