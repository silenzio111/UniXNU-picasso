++static void
++picasso_usb_gadget_start(vm_offset_t dwc, vm_offset_t smmu)
++{
++	vm_offset_t qs;
++	uint32_t devid = usb_rd(dwc, 0xc120);
++	uint32_t hwparams0 = usb_rd(dwc, 0xc140);
++	unsigned awidth = hwparams0 >> 24;
++	uint32_t gctl = usb_rd(dwc, GCTL);
