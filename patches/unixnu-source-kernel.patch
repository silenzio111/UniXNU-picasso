diff --git a/patches/xnu/zzz-picasso-console-ring.patch b/patches/xnu/zzz-picasso-console-ring.patch
new file mode 100644
index 0000000..1111116
--- /dev/null
+++ b/patches/xnu/zzz-picasso-console-ring.patch
@@ -0,0 +1,154 @@
+--- a/osfmk/console/serial_console.c
++++ b/osfmk/console/serial_console.c
+@@ -522,9 +522,130 @@
+  * @param str The string of characters to print.
+  * @param size The number of characters in `str` to print.
+  */
++/* picasso persistent console ring: mirror every console character to reserved
++ * physical RAM that survives warm reboots, so the previous boot's log can be
++ * extracted from a subsequent environment without a serial port. The buffer is
++ * at 0xB8000000, outside the 1 MiB panic region at 0xB7F00000 (which pe_init
++ * clears on every boot) and inside the firmware's Boot Ramdisk Gap. Layout:
++ * 32-byte header, then 1 MiB of wrapping data. On init the tail of the
++ * previous session is replayed to the console, which pe_init does not do for
++ * the panic region: a photograph of the top of the next boot's screen carries
++ * the end of the last boot's log.
++ */
++#define PICASSO_RING_PA         0xB8000000ULL
++#define PICASSO_RING_DATA_SZ    0x100000ULL
++#define PICASSO_RING_MAGIC      0x504F4C47u /* "PLOG" */
++#define PICASSO_RING_REPLAY_SZ  2048u
++
++struct picasso_ring_header {
++	volatile uint32_t magic;
++	volatile uint32_t version;
++	volatile uint32_t generation;
++	volatile uint32_t data_size;
++	volatile uint64_t write_total; /* monotonically increasing byte count */
++};
++
++static struct picasso_ring_header *picasso_ring_header;
++static char *picasso_ring_data;
++static bool picasso_ring_ready;
++
++void picasso_console_ring_init(void);
++
++/* Pause about three seconds on the generic timer so the replayed tail stays
++ * on screen long enough to photograph before the boot log scrolls past it. */
++static void
++picasso_ring_stall(void)
++{
++	uint64_t start, now, ticks;
++
++	__asm__ volatile ("isb\n\tmrs %0, cntvct_el0" : "=r"(start));
++	ticks = 19200000ULL * 3;
++	do {
++		__asm__ volatile ("isb\n\tmrs %0, cntvct_el0" : "=r"(now));
++	} while (now - start < ticks);
++}
++
++
++void
++picasso_console_ring_init(void)
++{
++	extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
++	vm_offset_t base;
++	uint32_t previous_generation = 0;
++	uint64_t previous_total = 0;
++	bool replay = false;
++
++	if (picasso_ring_ready) {
++		return;
++	}
++	base = ml_io_map_wcomb(PICASSO_RING_PA,
++	    sizeof(*picasso_ring_header) + PICASSO_RING_DATA_SZ);
++	if (!base) {
++		return;
++	}
++	picasso_ring_header = (struct picasso_ring_header *)base;
++	picasso_ring_data = (char *)(base + sizeof(*picasso_ring_header));
++	if (picasso_ring_header->magic == PICASSO_RING_MAGIC &&
++	    picasso_ring_header->version == 1 &&
++	    picasso_ring_header->data_size == PICASSO_RING_DATA_SZ) {
++		previous_generation = picasso_ring_header->generation;
++		previous_total = picasso_ring_header->write_total;
++		replay = previous_generation > 0 && previous_total > 0;
++	} else {
++		picasso_ring_header->magic = PICASSO_RING_MAGIC;
++		picasso_ring_header->version = 1;
++		picasso_ring_header->data_size = PICASSO_RING_DATA_SZ;
++		picasso_ring_header->write_total = 0;
++	}
++	picasso_ring_header->generation = previous_generation + 1;
++	picasso_ring_ready = true;
++	if (replay) {
++		/* The data area is not cleared, so the previous session is still
++		 * there; print its tail through the normal console so it reaches
++		 * screen, serial and this ring (as the new session's opening). */
++		uint64_t have = previous_total < PICASSO_RING_DATA_SZ ?
++		    previous_total : PICASSO_RING_DATA_SZ;
++		uint64_t take = have < PICASSO_RING_REPLAY_SZ ? have : PICASSO_RING_REPLAY_SZ;
++		uint64_t end = previous_total;
++		printf("\n=== picasso previous session tail (gen %u, %llu bytes total) ===\n",
++		    previous_generation, previous_total);
++		for (uint64_t i = take; i > 0; i--) {
++			char c = picasso_ring_data[(end - i) % PICASSO_RING_DATA_SZ];
++			printf("%c", (c >= 32 && c < 127) || c == '\n' ? c : '.');
++		}
++		printf("\n=== picasso end of previous session ===\n");
++		picasso_ring_stall();
++	}
++}
++
++static inline void
++picasso_ring_putc(char c)
++{
++	if (!picasso_ring_ready) {
++		return;
++	}
++	uint64_t total = picasso_ring_header->write_total;
++	picasso_ring_data[total % PICASSO_RING_DATA_SZ] = c;
++	picasso_ring_header->write_total = total + 1;
++}
++
++static inline void
++picasso_ring_puts(const char *str, int size)
++{
++	int index;
++
++	if (!picasso_ring_ready) {
++		return;
++	}
++	for (index = 0; index < size; index++) {
++		picasso_ring_putc(str[index]);
++	}
++}
++
+ void
+ console_write(char *str, int size)
+ {
++	picasso_ring_puts(str, size);
+ 	if (disableConsoleOutput) {
+ 		return;
+ 	}
+@@ -613,6 +734,7 @@
+ 	if (disableConsoleOutput) {
+ 		return;
+ 	}
++	picasso_ring_putc(c);
+ 
+ 	_cnputc(c, true);
+ }
+--- a/pexpert/arm/pe_init.c
++++ b/pexpert/arm/pe_init.c
+@@ -210,6 +210,10 @@
